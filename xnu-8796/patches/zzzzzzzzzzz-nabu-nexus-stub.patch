 }
 
+/*
+ * The port leaves skywalk partly initialised, and rapportd's nexus provider
+ * registration never returns -- the console stops on that line.  With
+ * nabu_nexus_off=1 every nexus syscall fails immediately so the caller can
+ * carry on instead of waiting on a stack that will not answer.
+ */
+extern int PE_parse_boot_argn(const char *, void *, int);
+
+static int
+nabu_nexus_disabled(void)
+{
+	static int cached = -1;
+
+	if (cached < 0) {
+		int off = 0;
+
+		cached = (PE_parse_boot_argn("nabu_nexus_off", &off, sizeof(off)) &&
+		    off != 0) ? 1 : 0;
+	}
+	return cached;
+}
+
 int
 __nexus_open(struct proc *p, struct __nexus_open_args *uap, int *retval)
 {
+	if (nabu_nexus_disabled()) {
+		return ENOTSUP;
+	}
 	struct nxctl *nxctl = NULL;
 	struct fileproc *fp = NULL;
 	struct nxctl_init init;
 	uuid_t nxctl_uuid;
