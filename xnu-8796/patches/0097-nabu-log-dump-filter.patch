--- a/bsd/dev/nabu_ufs.c
+++ b/bsd/dev/nabu_ufs.c
@@ -806,5 +806,26 @@
 /*
  * Dump the persisted ring (boot-arg nabulog_dump=1): the console log of the
  * PREVIOUS boot, printed on the panel this time, so a stuck boot can be read
  * without a recovery image.
  */
+/*
+ * Only the lines worth reading on a stuck boot: the display stack
+ * (NABU FB/SURF/SCALER), crashes and panics.  Everything else in the
+ * ring is daemon spam - one `exec` line per spawn, one AKS line per call.
+ */
+static int
+nabu_log_keep(const char *s)
+{
+	static const char *const want[] = {
+		"NABU FB:", "NABU SURF:", "NABU SCALER:", "CRASH ", "panic",
+	};
+	size_t i;
+
+	for (i = 0; i < sizeof(want) / sizeof(want[0]); i++) {
+		if (strnstr(s, want[i], strlen(s)) != NULL) {
+			return 1;
+		}
+	}
+	return 0;
+}
+
@@ -890,6 +908,8 @@
-		if (c == '\n') {
-			line[col] = '\0';
-			printf("%s\n", line);
-			col = 0;
-			continue;
-		}
+		if (c == '\n') {
+			line[col] = '\0';
+			if (nabu_log_keep(line)) {
+				printf("%s\n", line);
+			}
+			col = 0;
+			continue;
+		}
