+#define NABU_GPU_QFPROM_MEMORY_SIZE    0x00006fffu
+
+/* --- GMU registers --- */
+#define NABU_GMU_KGSL_GMU_REG_BASE    0x02c6a000u
+#define NABU_GMU_KGSL_GMU_REG_SIZE    0x00030000u
+#define NABU_GMU_KGSL_GMU_PDC_CFG_BASE    0x0b290000u
