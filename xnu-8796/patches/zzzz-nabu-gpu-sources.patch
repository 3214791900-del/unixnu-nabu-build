+#define NABU_GPUCC_GMU_GMU_CLK_CBCR 0x1098u   /* gpu_cc_cx_gmu_clk, dt id 3, enum id matches */
+#define NABU_GPUCC_GMU_GMU_CLK_MASK 0x00000001u
+#define NABU_GPUCC_GMU_CXO_CLK_CBCR 0x109cu   /* gpu_cc_cxo_clk, dt id 9, enum id differs */
+#define NABU_GPUCC_GMU_CXO_CLK_MASK 0x00000001u
+#define NABU_GPUCC_GMU_AXI_CLK_CBCR NABU_GPUCC_UNVERIFIED   /* dt id 19: provider is not gpucc */
+#define NABU_GPUCC_GMU_AXI_CLK_MASK 0u
+#define NABU_GPUCC_GMU_MEMNOC_CLK_CBCR NABU_GPUCC_UNVERIFIED   /* dt id 40: provider is not gpucc */
+#define NABU_GPUCC_GMU_MEMNOC_CLK_MASK 0u
+#define NABU_GPUCC_GMU_GPU_CC_AHB_CBCR 0x1078u   /* gpu_cc_ahb_clk, dt id 0, enum id matches */
