+
+#define NABU_GPU_KGSL_3D0_IRQ_INTID  300u
+#define NABU_GMU_KGSL_HFI_IRQ_INTID  304u
+#define NABU_GMU_KGSL_GMU_IRQ_INTID  305u
+
+/* --- GPUCC clock controller --- */
+#define NABU_GPUCC_CC_BASE_BASE    0x02c90000u
+#define NABU_GPUCC_CC_BASE_SIZE    0x00009000u
+#define NABU_GPUCC_REG_BASE        NABU_GPUCC_CC_BASE_BASE
+#define NABU_GPUCC_REG_SIZE        NABU_GPUCC_CC_BASE_SIZE
