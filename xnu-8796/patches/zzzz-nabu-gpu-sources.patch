+#define NABU_GPU_CLK_RBBMTIMER_CLK_ID                 9u   /* provider qcom,gpucc */
+#define NABU_GPU_CLK_MEM_CLK_ID                      19u   /* provider qcom,gcc */
+#define NABU_GPU_CLK_MEM_IFACE_CLK_ID                40u   /* provider qcom,gcc */
