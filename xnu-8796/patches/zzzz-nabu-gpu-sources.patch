+#define NABU_RPMH_TCS_BASE  0x18220d00u
+#define NABU_RPMH_CMD_DB    0x0c3f000cu
+/* cmd-db is keyed by the resource name, and the nabu DT spells these the Linux
+ * way (qcom,resource-name under rpmh-regulator-cxlvl / -gfxlvl). The first probe
+ * run used "cxlvl"/"gfxlvl" and got ENODEV for all three lookups. */
+#define NABU_RPMH_RES_CXLVL      "cx.lvl"   /* gpu_cx_gdsc -> pm8150l_s6_level */
+#define NABU_RPMH_RES_GFXLVL     "gfx.lvl"  /* gpu_gx_gdsc -> pm8150l_s2_level */
