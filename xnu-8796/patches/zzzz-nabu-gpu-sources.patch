+#define NABU_GPUCC_GPU_MEM_CLK_CBCR NABU_GPUCC_UNVERIFIED   /* dt id 19: provider is not gpucc */
+#define NABU_GPUCC_GPU_MEM_CLK_MASK 0u
+#define NABU_GPUCC_GPU_MEM_IFACE_CLK_CBCR NABU_GPUCC_UNVERIFIED   /* dt id 40: provider is not gpucc */
