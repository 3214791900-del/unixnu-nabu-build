diff --git a/bsd/dev/nabu_gpu.h b/bsd/dev/nabu_gpu.h
new file mode 100644
index 0000000..bbfec7d
--- /dev/null
+++ b/bsd/dev/nabu_gpu.h
@@ -0,0 +1,40 @@
+/*
+ * NABU GPU bring-up: public interface between the clock/rail stages.
+ *
+ * SPDX-License-Identifier: MIT
+ */
+#ifndef NABU_GPU_H
+#define NABU_GPU_H
+
+/* nabu_gpucc.c -- GPUCC clock gates */
+int nabu_gpucc_init(void);
+unsigned int nabu_gpucc_total_count(void);
+unsigned int nabu_gpucc_verified_count(void);
+int nabu_gpucc_clock_enable(const char *name);
+int nabu_gpucc_enable_gmu_set(void);
+void nabu_gpucc_report(void);
+int nabu_gpucc_enable_all(void);
+void nabu_gpucc_dump(void);
+
+/* nabu_gpu_power.c -- rails, ARC votes, sequence */
+void nabu_gpu_power_probe(void);
+int nabu_gpu_power_up(unsigned int cx_level, unsigned int gx_level);
+
+/* Staged bring-up for the first hardware writes: clocks first, ARC votes second.
+ * Both are gated by boot-arg so an ordinary boot writes nothing. */
+#define NABU_GPU_STEP_CLOCKS 0x1u
+#define NABU_GPU_STEP_ARC    0x2u
+int nabu_gpu_steps(unsigned int steps);
+void nabu_gpu_power_down(void);
+
+/* stage 6: load the GMU firmware and bring HFI up (needs power up first) */
+int nabu_gpu_start_gmu(unsigned int perfmode, unsigned int debuglevel);
+
+/* nabu_rpmh.c + nabu_rpmh_gpu.c -- ARC/bus votes and read-only slave discovery */
+int nabu_rpmh_arc_vote(const char *resource, unsigned int level);
+int nabu_rpmh_bus_vote(unsigned int master, unsigned int slave,
+    unsigned int ab_kbps, unsigned int ib_kbps);
+void nabu_rpmh_gpu_probe(void);
+void nabu_gpu_probe_boot(void);
+
+#endif /* NABU_GPU_H */
diff --git a/bsd/dev/nabu_gpu_gmuMem.h b/bsd/dev/nabu_gpu_gmuMem.h
new file mode 100644
index 0000000..1979907
--- /dev/null
+++ b/bsd/dev/nabu_gpu_gmuMem.h
@@ -0,0 +1,46 @@
+/*
+ * NABU GMU memory regions (Adreno 640 / a6xx GMU v1).
+ *
+ * The six region sizes are the ones the reference implementation uses; each value is
+ * cross-checked against NativeAdrenoGmuConfig.cpp:4-7 by gpu/check-hfi-driver.py, so
+ * they cannot drift silently. The fixed IOVAs live in NativeAdrenoGmuMemory.cpp, whose
+ * comment states they come from a6xx_gmu.c in the pinned tree (icache 0x4000 below the
+ * uncached region, debug at 0x60000000/0x60400000).
+ *
+ * SPDX-License-Identifier: MIT
+ */
+#ifndef NABU_GPU_GMU_MEM_H
+#define NABU_GPU_GMU_MEM_H
+
+#include <stdint.h>
+
+#define NABU_GMU_ICACHE_BYTES 0xffc000u   /* NativeAdrenoGmuConfig.cpp:5 */
+#define NABU_GMU_DUMMY_BYTES  0x4000u
+#define NABU_GMU_DEBUG_BYTES  0x7000u
+#define NABU_GMU_LOG_BYTES    0x4000u
+#define NABU_GMU_HFI_BYTES    0x4000u   /* the HFI queue table region */
+
+/* Sizes the caller must hand to NativeAdrenoGmuAllocator::allocate(). 	ables has no
+ * fixed value in the reference: NativeAdrenoGmuDefaultSizes() derives it from the
+ * table bytes, so it is a parameter here too rather than a guessed constant. */
+typedef struct nabu_gmu_mem_sizes {
+	uint64_t icache;
+	uint64_t dummy;
+	uint64_t debug;
+	uint64_t log;
+	uint64_t hfi;
+	uint64_t tables;
+} nabu_gmu_mem_sizes_t;
+
+static inline void nabu_gmu_mem_default_sizes(nabu_gmu_mem_sizes_t *sizes, uint64_t table_bytes)
+{
+	if (!sizes) return;
+	sizes->icache = NABU_GMU_ICACHE_BYTES;
+	sizes->dummy  = NABU_GMU_DUMMY_BYTES;
+	sizes->debug  = NABU_GMU_DEBUG_BYTES;
+	sizes->log    = NABU_GMU_LOG_BYTES;
+	sizes->hfi    = NABU_GMU_HFI_BYTES;
+	sizes->tables = table_bytes;
+}
+
+#endif /* NABU_GPU_GMU_MEM_H */
diff --git a/bsd/dev/nabu_gpu_gmu_boot.c b/bsd/dev/nabu_gpu_gmu_boot.c
new file mode 100644
index 0000000..72a2c85
--- /dev/null
+++ b/bsd/dev/nabu_gpu_gmu_boot.c
@@ -0,0 +1,28 @@
+/*
+ * NABU GMU bring-up shim -- implementation. See nabu_gpu_gmu_boot.h.
+ *
+ * SPDX-License-Identifier: MIT
+ */
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+
+#include "nabu_gpu_hfi.h"
+#include "nabu_gpu_gmu_boot.h"
+
+int
+nabu_gpu_gmu_boot(const nabu_gmu_boot_t *boot)
+{
+	if (!boot || !boot->regs) {
+		return EINVAL;
+	}
+	/* fail closed: pointing the GMU at 0 would hand it memory it cannot see */
+	if (!boot->hfi_iova || !boot->tables_iova) {
+		printf("NABU GMU: queue table / SFR addresses missing "
+		    "(hfi=%#llx tables=%#llx); refusing to start HFI\n",
+		    (unsigned long long)boot->hfi_iova, (unsigned long long)boot->tables_iova);
+		return EINVAL;
+	}
+	return nabu_gpu_hfi_start((uint32_t)boot->regs, boot->hfi_iova, boot->tables_iova,
+	    boot->perfmode, boot->debuglevel);
+}
diff --git a/bsd/dev/nabu_gpu_gmu_boot.h b/bsd/dev/nabu_gpu_gmu_boot.h
new file mode 100644
index 0000000..421a295
--- /dev/null
+++ b/bsd/dev/nabu_gpu_gmu_boot.h
@@ -0,0 +1,37 @@
+/*
+ * NABU GMU bring-up shim (C, callable from the C++ driver).
+ *
+ * The reference implementation allocates the GMU regions with
+ * NativeAdrenoGmuAllocator and maps them into the GPU address space with
+ * mapInto(NativeAdrenoVm *). That plumbing is C++ (see
+ * NativeAdrenoGmuMemory.h, and the call sites NativeAdrenoGmuContext.cpp:79/111
+ * and NativeAdrenoService.cpp:336), so it stays on the C++ side. This shim takes
+ * the two IOVAs it produces and runs the a6xx HFI sequence.
+ *
+ * The caller supplies:
+ *   hfi_iova     the HFI queue-table region  (NABU_GMU_HFI_BYTES = 0x4000)
+ *   tables_iova  the SFR/tables region       (NativeAdrenoGmuDefaultSizes)
+ * Both must be non-zero -- a zero address here would point the GMU at memory it
+ * cannot see, so the shim refuses instead of writing a register.
+ *
+ * SPDX-License-Identifier: MIT
+ */
+#ifndef NABU_GPU_GMU_BOOT_H
+#define NABU_GPU_GMU_BOOT_H
+
+#include <stdint.h>
+
+#include "nabu_gpu_gmuMem.h"
+
+typedef struct nabu_gmu_boot {
+	uint64_t regs;           /* GMU register window base (virtual) */
+	uint64_t hfi_iova;       /* queue-table region device address */
+	uint64_t tables_iova;    /* SFR/tables region device address */
+	uint32_t perfmode;
+	uint32_t debuglevel;
+} nabu_gmu_boot_t;
+
+/* Returns 0 only after the HFI handshake succeeded. */
+int nabu_gpu_gmu_boot(const nabu_gmu_boot_t *boot);
+
+#endif /* NABU_GPU_GMU_BOOT_H */
diff --git a/bsd/dev/nabu_gpu_hfi.c b/bsd/dev/nabu_gpu_hfi.c
new file mode 100644
index 0000000..53d382f
--- /dev/null
+++ b/bsd/dev/nabu_gpu_hfi.c
@@ -0,0 +1,111 @@
+/*
+ * NABU GMU HFI bring-up. Register offsets come from the derived header, which took
+ * them from the pinned a6xx_gmu.xml; the sequence follows the pinned a6xx_gmu.c.
+ *
+ * Order (a6xx_gmu.c):
+ *   :HFI_QTBL_ADDR   queue table address must be visible to the GMU first
+ *   :HFI_QTBL_INFO   queue count/type
+ *   :HFI_CTRL_INIT   tell the firmware the table is valid
+ *   :HOST2GMU_INTR_SET  raise the doorbell
+ *   :GMU2HOST_INTR_INFO poll for the firmware's reply
+ *
+ * SPDX-License-Identifier: MIT
+ */
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <machine/machine_routines.h>
+
+#include "nabu_gpu_hfi.h"
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern void delay(int);
+
+#define NABU_HFI_TIMEOUT_US  100000u
+#define NABU_HFI_GMU2HOST_ACK (1u << 0)
+
+static uint32_t nabu_hfi_base;
+
+static inline uint32_t
+nabu_hfi_read(uint32_t off)
+{
+	volatile uint32_t *base = (volatile uint32_t *)(uintptr_t)nabu_hfi_base;
+	uint32_t value = base[off >> 2];
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return value;
+}
+
+static inline void
+nabu_hfi_write(uint32_t off, uint32_t value)
+{
+	volatile uint32_t *base = (volatile uint32_t *)(uintptr_t)nabu_hfi_base;
+	__asm__ volatile("dmb oshst" ::: "memory");
+	base[off >> 2] = value;
+	__asm__ volatile("dsb osh" ::: "memory");
+}
+
+static int
+nabu_hfi_wait_ack(uint32_t expect_id, uint32_t *acked)
+{
+	for (unsigned elapsed = 0; elapsed < NABU_HFI_TIMEOUT_US; ++elapsed) {
+		uint32_t info = nabu_hfi_read(A640_GMU_GMU2HOST_INTR_INFO);
+		if (info == 0xffffffffu) {
+			printf("NABU GMU: GMU2HOST_INTR_INFO reads all ones; aborting\n");
+			return EIO;
+		}
+		if (info & NABU_HFI_GMU2HOST_ACK) {
+			/* ack the interrupt, then report what the firmware said */
+			nabu_hfi_write(A640_GMU_GMU2HOST_INTR_CLR, info);
+			if (acked) {
+				*acked = info;
+			}
+			(void)expect_id;
+			return 0;
+		}
+		delay(1);
+	}
+	printf("NABU GMU: no HFI reply within %u us (intr info %#x)\n",
+	    NABU_HFI_TIMEOUT_US, nabu_hfi_read(A640_GMU_GMU2HOST_INTR_INFO));
+	return ETIMEDOUT;
+}
+
+int
+nabu_gpu_hfi_start(uint32_t gmu_base, uint64_t queue_table_iova, uint64_t sfr_iova,
+    uint32_t perfmode, uint32_t debuglevel)
+{
+	if (!gmu_base) {
+		return EINVAL;
+	}
+	if (!queue_table_iova) {
+		printf("NABU GMU: queue table address is required\n");
+		return EINVAL;
+	}
+	nabu_hfi_base = gmu_base;
+	(void)sfr_iova;
+
+	/* the firmware must see a valid table before HFI is enabled */
+	nabu_hfi_write(A640_GMU_HFI_QTBL_ADDR, (uint32_t)(queue_table_iova & 0xffffffffu));
+	nabu_hfi_write(A640_GMU_HFI_QTBL_INFO, NABU_HFI_MAX_QUEUES);
+	nabu_hfi_write(A640_GMU_HFI_CTRL_INIT, 1u);
+
+	/* doorbell */
+	nabu_hfi_write(A640_GMU_HOST2GMU_INTR_SET, 1u);
+
+	uint32_t acked = 0;
+	int error = nabu_hfi_wait_ack(NABU_HFI_H2F_MSG_INIT, &acked);
+	if (error) {
+		return error;
+	}
+
+	/* 0x8 = the reference's "init done" bit in CM3_FW_INIT_RESULT */
+	uint32_t result = nabu_hfi_read(A640_GMU_CM3_FW_INIT_RESULT);
+	if (!(result & 0x8u)) {
+		printf("NABU GMU: firmware init result %#x does not report ready\n", result);
+		return EIO;
+	}
+
+	uint32_t version = nabu_hfi_read(A640_GMU_CORE_FW_VERSION);
+	printf("NABU GMU: HFI up, intr=%#x fw_init=%#x core_version=%#x perf=%u dbg=%u\n",
+	    acked, result, version, perfmode, debuglevel);
+	return 0;
+}
diff --git a/bsd/dev/nabu_gpu_hfi.h b/bsd/dev/nabu_gpu_hfi.h
new file mode 100644
index 0000000..456b23b
--- /dev/null
+++ b/bsd/dev/nabu_gpu_hfi.h
@@ -0,0 +1,114 @@
+/*
+ * NABU GMU host-firmware interface (HFI) for the Adreno 640 / a6xx GMU v1.
+ *
+ * Constants and layouts are transcribed from the pinned kernel header
+ * (.cache/adreno-source/.../adreno/a6xx_hfi.h), with the source line noted so the
+ * checker can re-verify them:
+ *
+ *   a6xx_hfi.h:7    HFI_MAX_QUEUES 3
+ *   a6xx_hfi.h:52   HFI_COMMAND_QUEUE 0
+ *   a6xx_hfi.h:55   HFI_RESPONSE_QUEUE 1
+ *   a6xx_hfi.h:57   HFI_HEADER_ID(msg)      ((msg) & 0xff)
+ *   a6xx_hfi.h:58   HFI_HEADER_SIZE(msg)    (((msg) >> 8) & 0xff)
+ *   a6xx_hfi.h:59   HFI_HEADER_SEQNUM(msg)  (((msg) >> 20) & 0xfff)
+ *   a6xx_hfi.h:66   HFI_MSG_CMD 0 / ACK 1 / ACK_V1 2
+ *   a6xx_hfi.h:70   HFI_F2H_MSG_ACK 126
+ *   a6xx_hfi.h:79   HFI_F2H_MSG_ERROR 100
+ *   a6xx_hfi.h:87   HFI_H2F_MSG_INIT 0
+ *   a6xx_hfi.h:97   HFI_H2F_MSG_FW_VERSION 1
+ *   a6xx_hfi.h:104  HFI_H2F_MSG_PERF_TABLE 4
+ *   a6xx_hfi.h:135  HFI_H2F_MSG_BW_TABLE 3
+ *   a6xx_hfi.h:150  HFI_H2F_MSG_TEST 5
+ *
+ * Queue-table and queue-header structs follow the same header (a6xx_hfi.h:9..33);
+ * their field order matters because the GMU reads them directly from memory.
+ *
+ * SPDX-License-Identifier: MIT
+ */
+#ifndef NABU_GPU_HFI_H
+#define NABU_GPU_HFI_H
+
+#include <stdint.h>
+
+#include "NativeAdrenoA640HwInit.h"
+
+#define NABU_HFI_MAX_QUEUES     3      /* a6xx_hfi.h:7  */
+#define NABU_HFI_COMMAND_QUEUE  0      /* a6xx_hfi.h:52 */
+#define NABU_HFI_RESPONSE_QUEUE 1      /* a6xx_hfi.h:55 */
+
+#define NABU_HFI_HEADER_ID(msg)     ((msg) & 0xffu)             /* a6xx_hfi.h:57 */
+#define NABU_HFI_HEADER_SIZE(msg)   (((msg) >> 8) & 0xffu)      /* a6xx_hfi.h:58 */
+#define NABU_HFI_HEADER_SEQNUM(msg) (((msg) >> 20) & 0xfffu)    /* a6xx_hfi.h:59 */
+#define NABU_HFI_HEADER(id, size, seq) \
+	(((uint32_t)(id) & 0xffu) | (((uint32_t)(size) & 0xffu) << 8) | \
+	 (((uint32_t)(seq) & 0xfffu) << 20))
+
+/* message classes (a6xx_hfi.h:66) */
+#define NABU_HFI_MSG_CMD    0
+#define NABU_HFI_MSG_ACK    1
+#define NABU_HFI_MSG_ACK_V1 2
+
+/* firmware -> host (a6xx_hfi.h:70,79) */
+#define NABU_HFI_F2H_MSG_ACK   126
+#define NABU_HFI_F2H_MSG_ERROR 100
+
+/* host -> firmware (a6xx_hfi.h:87,97,104,135,150) */
+#define NABU_HFI_H2F_MSG_INIT        0
+#define NABU_HFI_H2F_MSG_FW_VERSION  1
+#define NABU_HFI_H2F_MSG_BW_TABLE    3
+#define NABU_HFI_H2F_MSG_PERF_TABLE  4
+#define NABU_HFI_H2F_MSG_TEST        5
+
+/* queue table header: the GMU reads this structure straight out of GMEM */
+typedef struct nabu_hfi_queue_table_header {
+	uint32_t version;
+	uint32_t size;
+	uint32_t daq_offset[NABU_HFI_MAX_QUEUES];
+	uint32_t daq_size_bytes[NABU_HFI_MAX_QUEUES];
+	uint32_t daq_type[NABU_HFI_MAX_QUEUES];
+} nabu_hfi_queue_table_header_t;
+
+typedef struct nabu_hfi_queue_header {
+	uint32_t status;
+	uint32_t iova;
+	uint32_t type;
+	uint32_t size;
+	uint32_t msg_size;
+	uint32_t dropped;
+	uint32_t rx_watermark;
+	uint32_t tx_watermark;
+	uint32_t rx_request;
+	uint32_t tx_request;
+	uint32_t read_index;
+	uint32_t write_index;
+} nabu_hfi_queue_header_t;
+
+typedef struct nabu_hfi_queue {
+	nabu_hfi_queue_header_t *header;
+	uint32_t *data;
+	uint32_t size;
+	uint32_t msg_size;
+} nabu_hfi_queue_t;
+
+typedef struct nabu_hfi_msg_init {
+	uint32_t header;
+	uint64_t dbg_queue;
+	uint32_t perfmode;
+	uint32_t debuglevel;
+	uint32_t features;
+} nabu_hfi_msg_init_t;
+
+typedef struct nabu_hfi_msg_ack {
+	uint32_t header;
+	uint32_t ack;
+	uint32_t payload[4];
+} nabu_hfi_msg_ack_t;
+
+#define NABU_HFI_ACK_MSG(ack) ((ack) & 0xffu)
+
+/* bring the interface up: point the GMU at the queue table, enable HFI, wait for
+ * FW_VERSION/ACK. Returns 0 only after a valid response was decoded. */
+int nabu_gpu_hfi_start(uint32_t gmu_base, uint64_t queue_table_iova, uint64_t sfr_iova,
+    uint32_t perfmode, uint32_t debuglevel);
+
+#endif /* NABU_GPU_HFI_H */
diff --git a/bsd/dev/nabu_gpu_power.c b/bsd/dev/nabu_gpu_power.c
new file mode 100644
index 0000000..17c09b9
--- /dev/null
+++ b/bsd/dev/nabu_gpu_power.c
@@ -0,0 +1,245 @@
+/*
+ * NABU GPU power sequence: GPUCC clocks -> RPMh ARC rails -> GDSC -> GMU handoff.
+ *
+ * This is the skeleton of the a6xx bring-up order documented in
+ * gpu/GPU-PLAN-zh.md section 6.2. It exists so the sequence, the rollback and the
+ * failure reporting are reviewable before any register is written, and so the
+ * addresses come from gpu/nabu-gpu-board.json (via NabuGpuBoard.h) instead of
+ * being retyped.
+ *
+ * Two kinds of data are deliberately missing and therefore gated:
+ *
+ *   1. GPUCC clock CBCR offsets -- nabu_gpucc.c refuses to program them.
+ *   2. GDSC bit polarity -- the GDSCR layout below (PWR_ON bit 31, SW_COLLAPSE
+ *      bit 0) is Qualcomm's gdsc.c layout, not something this board's device tree
+ *      states. The write path is gated by NABU_GDSC_BITS_VERIFIED so that a wrong
+ *      polarity cannot silently power off a rail. Flip it only after
+ *      nabu_gpu_power_probe() has printed plausible GDSCR values on hardware.
+ *
+ * RMBh votes are delegated to nabu_rpmh.c: its existing entry point
+ * (nabu_rpmh_vreg_enable) is board-specific to PM6150L L11C and must not be
+ * reused for ARC rails, so two new primitives are declared here and must be
+ * implemented next to it, on the same RSC/cmd-db transport.
+ *
+ * SPDX-License-Identifier: MIT
+ */
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <machine/machine_routines.h>
+
+#include "NabuGpuBoard.h"
+#include "nabu_gpu.h"
+#include "nabu_gpu_hfi.h"
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+
+/* gdsc.c layout; see the gating note above. */
+#define NABU_GDSCR_PWR_ON        (1u << 31)
+#define NABU_GDSCR_SW_COLLAPSE   (1u << 0)
+#define NABU_GDSC_BITS_VERIFIED  0
+
+#define NABU_GPU_OK              0
+
+typedef struct nabu_gpu_rail {
+	const char *name;
+	unsigned int gdsc_base;      /* inside GPUCC, from the device tree */
+	const char *rpmh_resource;   /* cxlvl / gfxlvl */
+} nabu_gpu_rail_t;
+
+static nabu_gpu_rail_t nabu_gpu_rails[] = {
+	{ "gpu_cx", NABU_GPU_CX_GDSC_BASE, NABU_RPMH_RES_CXLVL },
+	{ "gpu_gx", NABU_GPU_GX_GDSC_BASE, NABU_RPMH_RES_GFXLVL },
+};
+
+static int
+nabu_gpu_gdsc_read(unsigned int base)
+{
+	return *(volatile unsigned int *)ml_io_map(base, NABU_GPU_CX_GDSC_REG_SIZE);
+}
+
+/*
+ * Read-only inventory: the first hardware run uses this to confirm the GDSCR
+ * polarity and the clock controller before anything is driven.
+ */
+void
+nabu_gpu_power_probe(void)
+{
+	printf("NABU GPU: chipid %#x, GPU window %#x+%#x, GMU window %#x+%#x\n",
+	    NABU_GPU_CHIPID, NABU_GPU_KGSL_3D0_REG_MEMORY_BASE,
+	    NABU_GPU_KGSL_3D0_REG_MEMORY_SIZE, NABU_GMU_KGSL_GMU_REG_BASE,
+	    NABU_GMU_KGSL_GMU_REG_SIZE);
+	for (unsigned int i = 0; i < sizeof(nabu_gpu_rails) / sizeof(nabu_gpu_rails[0]); i++) {
+		nabu_gpu_rail_t *rail = &nabu_gpu_rails[i];
+		unsigned int gdscr = nabu_gpu_gdsc_read(rail->gdsc_base);
+		printf("NABU GPU: %s gdscr(%#x) = %#x%s%s%s\n", rail->name, rail->gdsc_base, gdscr,
+		    (gdscr & NABU_GDSCR_PWR_ON) ? " PWR_ON" : " !PWR_ON",
+		    (gdscr & NABU_GDSCR_SW_COLLAPSE) ? " SW_COLLAPSE" : " sw-enabled",
+		    NABU_GDSC_BITS_VERIFIED ? " bits-verified" : " bits-UNVERIFIED(read-only)");
+	}
+	printf("NABU GPU: clocks verified %u/%u (see nabu_gpucc_report)\n",
+	    nabu_gpucc_verified_count(), nabu_gpucc_total_count());
+	/* Which cmd-db slave owns cxlvl/gfxlvl/cnoc is data we do not have yet; the
+	 * probe prints it read-only so the votes can be enabled with real ids. */
+	nabu_rpmh_gpu_probe();
+}
+
+static int
+nabu_gpu_gdsc_enable(nabu_gpu_rail_t *rail)
+{
+	if (!NABU_GDSC_BITS_VERIFIED) {
+		printf("NABU GPU: %s GDSC polarity unverified; refusing to write gdscr(%#x)=%#x\n",
+		    rail->name, rail->gdsc_base, nabu_gpu_gdsc_read(rail->gdsc_base));
+		return ENOTSUP;
+	}
+	unsigned int gdscr = nabu_gpu_gdsc_read(rail->gdsc_base);
+	gdscr &= ~NABU_GDSCR_SW_COLLAPSE;
+	*(volatile unsigned int *)ml_io_map(rail->gdsc_base, NABU_GPU_CX_GDSC_REG_SIZE) = gdscr;
+	return NABU_GPU_OK;
+}
+
+/*
+ * Bring-up order. Each stage reports its own failure so a black screen still
+ * leaves a trace in the console ring (nabulog).
+ */
+int
+nabu_gpu_power_up(unsigned int cx_level, unsigned int gx_level)
+{
+	int error;
+
+	printf("NABU GPU: stage 1/5 GPUCC clocks\n");
+	error = nabu_gpucc_init();
+	if (error) {
+		printf("NABU GPU: stage 1 failed (%d)\n", error);
+		return error;
+	}
+	error = nabu_gpucc_enable_gmu_set();
+	if (error) {
+		printf("NABU GPU: stage 1 clock enable failed (%d)\n", error);
+		return error;
+	}
+
+	printf("NABU GPU: stage 2/5 bus vote master=%u slave=%u ib=%u KBps\n",
+	    NABU_BUS_MASTER, NABU_BUS_SLAVE, NABU_BUS_ACTIVE_IB);
+	error = nabu_rpmh_bus_vote(NABU_BUS_MASTER, NABU_BUS_SLAVE,
+	    NABU_BUS_ACTIVE_AB, NABU_BUS_ACTIVE_IB);
+	if (error) {
+		printf("NABU GPU: stage 2 failed (%d)\n", error);
+		return error;
+	}
+
+	printf("NABU GPU: stage 3/5 ARC votes cx=%u gx=%u\n", cx_level, gx_level);
+	error = nabu_rpmh_arc_vote(NABU_RPMH_RES_CXLVL, cx_level);
+	if (error) {
+		printf("NABU GPU: stage 3 CX vote failed (%d)\n", error);
+		return error;
+	}
+	error = nabu_rpmh_arc_vote(NABU_RPMH_RES_GFXLVL, 0);
+	if (error) {
+		printf("NABU GPU: stage 3 GX retention vote failed (%d)\n", error);
+		return error;
+	}
+
+	printf("NABU GPU: stage 4/5 CX GDSC\n");
+	error = nabu_gpu_gdsc_enable(&nabu_gpu_rails[0]);
+	if (error) {
+		return error;
+	}
+
+	printf("NABU GPU: stage 5/5 GX rail + GDSC\n");
+	error = nabu_rpmh_arc_vote(NABU_RPMH_RES_GFXLVL, gx_level);
+	if (error) {
+		printf("NABU GPU: stage 5 GX vote failed (%d)\n", error);
+		return error;
+	}
+	error = nabu_gpu_gdsc_enable(&nabu_gpu_rails[1]);
+	if (error) {
+		return error;
+	}
+
+	printf("NABU GPU: power up complete; ready to load GMU firmware\n");
+	return NABU_GPU_OK;
+}
+
+/*
+ * Rollback: collapse GX then CX, drop both ARC votes, release the bus vote.
+ * Order is the reverse of power-up so the GX rail never floats while the CX
+ * rail is still up.
+ */
+void
+nabu_gpu_power_down(void)
+{
+	if (NABU_GDSC_BITS_VERIFIED) {
+		*(volatile unsigned int *)ml_io_map(nabu_gpu_rails[1].gdsc_base,
+		    NABU_GPU_CX_GDSC_REG_SIZE) |= NABU_GDSCR_SW_COLLAPSE;
+		*(volatile unsigned int *)ml_io_map(nabu_gpu_rails[0].gdsc_base,
+		    NABU_GPU_CX_GDSC_REG_SIZE) |= NABU_GDSCR_SW_COLLAPSE;
+	} else {
+		printf("NABU GPU: power_down skipped, GDSC polarity unverified\n");
+	}
+	(void)nabu_rpmh_arc_vote(NABU_RPMH_RES_GFXLVL, 0);
+	(void)nabu_rpmh_arc_vote(NABU_RPMH_RES_CXLVL, 0);
+	(void)nabu_rpmh_bus_vote(NABU_BUS_MASTER, NABU_BUS_SLAVE, 0, 0);
+	printf("NABU GPU: power down requested\n");
+}
+
+/*
+ * Stage 6, kept separate from nabu_gpu_power_up() so the five numbered stages the
+ * host test checks stay stable. The GMU needs the rails and clocks from stages 1-5
+ * before it can run; the queue table and SFR addresses are supplied by the caller
+ * because they live in GPU-visible memory the bus layer allocates.
+ */
+int
+nabu_gpu_start_gmu(unsigned int perfmode, unsigned int debuglevel)
+{
+	printf("NABU GPU: stage 6 GMU bring-up (HFI)\n");
+	int error = nabu_gpu_hfi_start(NABU_GMU_KGSL_GMU_REG_BASE, 0, 0, perfmode, debuglevel);
+	if (error) {
+		printf("NABU GPU: stage 6 failed (%d); ring submit must not be attempted\n", error);
+		return error;
+	}
+	printf("NABU GPU: stage 6 complete; safe to program the ring\n");
+	return NABU_GPU_OK;
+}
+
+/*
+ * Staged bring-up for hardware runs, used by boot-arg levels 2 and 3.
+ *
+ * Deliberately absent:
+ *   - any GDSC write (polarity verified in one direction only; a wrong write
+ *     collapses a rail with no log at all)
+ *   - the bus vote (which BCM the grp3d path uses is still unresolved: the DT's
+ *     qcom,bcm-dev nodes are empty, so it has to come from the msm_bus topology)
+ */
+int
+nabu_gpu_steps(unsigned int steps)
+{
+	int error;
+
+	printf("NABU GPU: steps=%#x (no GDSC write, no bus vote)\n", steps);
+	if (steps & NABU_GPU_STEP_CLOCKS) {
+		error = nabu_gpucc_init();
+		if (error) {
+			printf("NABU GPU: clock controller map failed (%d)\n", error);
+			return error;
+		}
+		error = nabu_gpucc_enable_all();
+		nabu_gpucc_dump();
+		if (error) {
+			return error;
+		}
+	}
+	if (steps & NABU_GPU_STEP_ARC) {
+		static const char *const rails[] = {
+			NABU_RPMH_RES_CXLVL, NABU_RPMH_RES_GFXLVL,
+		};
+
+		for (unsigned int i = 0; i < sizeof(rails) / sizeof(rails[0]); i++) {
+			printf("NABU GPU: ARC vote %s level 0 (retention)\n", rails[i]);
+			error = nabu_rpmh_arc_vote(rails[i], 0);
+			printf("NABU GPU: ARC vote %s -> %d\n", rails[i], error);
+		}
+	}
+	printf("NABU GPU: steps done\n");
+	return NABU_GPU_OK;
+}
diff --git a/bsd/dev/nabu_gpu_ring.c b/bsd/dev/nabu_gpu_ring.c
new file mode 100644
index 0000000..d08d39f
--- /dev/null
+++ b/bsd/dev/nabu_gpu_ring.c
@@ -0,0 +1,144 @@
+/*
+ * NABU GPU command ring -- implementation. See nabu_gpu_ring.h for the pinned
+ * source lines behind every step.
+ *
+ * SPDX-License-Identifier: MIT
+ */
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <machine/machine_routines.h>
+
+#include "nabu_gpu_ring.h"
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern void delay(int);
+
+#define NABU_RBBM_STATUS_CP_AHB_BUSY_CX_MASTER (1u << 1)   /* a6xx_gpu.c:123 */
+#define NABU_RING_ALIGN 32u                                /* 32 dword alignment */
+
+static inline uint32_t
+nabu_ring_read(nabu_gpu_ring_t *ring, uint32_t off)
+{
+	volatile uint32_t *base = (volatile uint32_t *)(uintptr_t)ring->config.regs;
+	uint32_t value = base[off >> 2];
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return value;
+}
+
+static inline void
+nabu_ring_write(nabu_gpu_ring_t *ring, uint32_t off, uint32_t value)
+{
+	volatile uint32_t *base = (volatile uint32_t *)(uintptr_t)ring->config.regs;
+	__asm__ volatile("dmb oshst" ::: "memory");
+	base[off >> 2] = value;
+	__asm__ volatile("dsb osh" ::: "memory");
+}
+
+static void
+nabu_ring_write64(nabu_gpu_ring_t *ring, uint32_t off, uint64_t value)
+{
+	nabu_ring_write(ring, off, (uint32_t)(value & 0xffffffffu));
+	nabu_ring_write(ring, off + 4, (uint32_t)(value >> 32));
+}
+
+int
+nabu_gpu_ring_init(nabu_gpu_ring_t *ring, const nabu_gpu_ring_config_t *config)
+{
+	if (!ring || !config) {
+		return EINVAL;
+	}
+	/* fail closed: without the RB_CNTL constants the chip would be programmed
+	 * with an invented value, so refuse before touching a register */
+	if (!config->rb_cntl_default) {
+		printf("NABU RING: MSM_GPU_RB_CNTL_DEFAULT not supplied; refusing init\n");
+		return EINVAL;
+	}
+	if (!config->ring_iova || (config->ring_bytes & (config->ring_bytes - 1)) ||
+	    config->ring_bytes < 4096) {
+		printf("NABU RING: ring must be a power-of-two >= 4 KiB (%llu)\n",
+		    (unsigned long long)config->ring_bytes);
+		return EINVAL;
+	}
+	if (!config->sqe_iova || !config->rptr_shadow_iova) {
+		printf("NABU RING: SQE microcode and RPTR shadow are required\n");
+		return EINVAL;
+	}
+	ring->config = *config;
+	ring->rptr_shadow = (volatile uint32_t *)(uintptr_t)config->rptr_shadow_iova;
+	ring->wptr = 0;
+	ring->ready = 0;
+
+	/* a6xx_gpu.c:122 -- the GPU must be idle before the ring is programmed */
+	uint32_t status = nabu_ring_read(ring, A640_RBBM_STATUS);
+	if (status & ~NABU_RBBM_STATUS_CP_AHB_BUSY_CX_MASTER) {
+		printf("NABU RING: RBBM_STATUS %#x is not idle; refusing init\n", status);
+		return EBUSY;
+	}
+
+	/* a6xx_gpu.c:1428 -- interrupt enables go first in the reference order */
+	nabu_ring_write(ring, A640_RBBM_INT_0_MASK, config->int_mask);
+
+	/* a6xx_gpu.c:1435 -- SQE microcode base, then the ring address */
+	nabu_ring_write64(ring, A640_CP_SQE_INSTR_BASE, config->sqe_iova);
+
+	/* a6xx_gpu.c:1438 */
+	nabu_ring_write64(ring, A640_CP_RB_BASE, config->ring_iova);
+
+	/* a6xx_gpu.c:1444/1447 -- a640 has no ADRENO_QUIRK_HAS_HW_APRIV, so the
+	 * NO_UPDATE variant applies and the RPTR shadow below becomes authoritative */
+	uint32_t cntl = config->rb_cntl_default;
+	if (!config->rb_cntl_no_update) {
+		printf("NABU RING: AXXX_CP_RB_CNTL_NO_UPDATE not supplied; refusing init\n");
+		return EINVAL;
+	}
+	cntl |= config->rb_cntl_no_update;
+	nabu_ring_write(ring, A640_CP_RB_CNTL, cntl);
+
+	/* a6xx_gpu.c:1452 -- RPTR shadow */
+	nabu_ring_write64(ring, A640_CP_RB_RPTR_ADDR, config->rptr_shadow_iova);
+	if (ring->rptr_shadow) {
+		*ring->rptr_shadow = 0;
+	}
+
+	ring->ready = 1;
+	printf("NABU RING: ready iova=%#llx bytes=%llu cntl=%#x shadow=%#llx\n",
+	    (unsigned long long)config->ring_iova, (unsigned long long)config->ring_bytes,
+	    cntl, (unsigned long long)config->rptr_shadow_iova);
+	return 0;
+}
+
+int
+nabu_gpu_ring_submit(nabu_gpu_ring_t *ring, uint32_t dwords)
+{
+	if (!ring || !ring->ready) {
+		return ENXIO;
+	}
+	if (!dwords) {
+		return EINVAL;
+	}
+	uint32_t mask = (uint32_t)(ring->config.ring_bytes / 4) - 1u;
+	ring->wptr = (ring->wptr + dwords + NABU_RING_ALIGN - 1u) & ~(NABU_RING_ALIGN - 1u);
+	ring->wptr &= mask;
+	/* a6xx_gpu.c:182 -- fenced write so the CP sees the payload before the doorbell */
+	__asm__ volatile("dsb sy" ::: "memory");
+	nabu_ring_write(ring, A640_CP_RB_WPTR, ring->wptr);
+	return 0;
+}
+
+int
+nabu_gpu_ring_wait(nabu_gpu_ring_t *ring, uint32_t target, unsigned timeout_us)
+{
+	if (!ring || !ring->ready || !ring->rptr_shadow) {
+		return ENXIO;
+	}
+	for (unsigned elapsed = 0; elapsed < timeout_us; ++elapsed) {
+		if (*ring->rptr_shadow >= target) {
+			return 0;
+		}
+		delay(1);
+	}
+	printf("NABU RING: timeout waiting for rptr %u (shadow %u)\n", target,
+	    *ring->rptr_shadow);
+	return ETIMEDOUT;
+}
diff --git a/bsd/dev/nabu_gpu_ring.h b/bsd/dev/nabu_gpu_ring.h
new file mode 100644
index 0000000..331afa6
--- /dev/null
+++ b/bsd/dev/nabu_gpu_ring.h
@@ -0,0 +1,71 @@
+/*
+ * NABU GPU command ring for the Adreno 640 (a6xx / SM8150-AC).
+ *
+ * Every step below is a transcription of the pinned a6xx driver, with the source
+ * line kept in the comment so the sequence can be re-audited:
+ *
+ *   a6xx_gpu.c:1428  RBBM_INT_0_MASK = A6XX_INT_MASK        (interrupt enables)
+ *   a6xx_gpu.c:1435  CP_SQE_INSTR_BASE (u64) = SQE microcode IOVA
+ *   a6xx_gpu.c:1438  CP_RB_BASE (u64)        = ring IOVA
+ *   a6xx_gpu.c:1444  CP_RB_CNTL = DEFAULT        when the chip has hw_apriv
+ *   a6xx_gpu.c:1447  CP_RB_CNTL = DEFAULT|NO_UPDATE when it does not
+ *   a6xx_gpu.c:1452  CP_RB_RPTR_ADDR (u64)   = RPTR shadow IOVA
+ *   a6xx_gpu.c:182   doorbell: CP_RB_WPTR = wptr, fenced with BIT(0)
+ *   a6xx_gpu.c:122   health gate: RBBM_STATUS & ~CP_AHB_BUSY_CX_MASTER
+ *   a6xx_gpu.c:2397  "Can't read CP_RB_RPTR register reliably" -> use the shadow
+ *
+ * Two facts about a640 that decide the path, both read from the pinned catalog
+ * (a6xx_catalog.c, the 0x06040001 entry) rather than assumed:
+ *   - its quirks are HAS_CACHED_COHERENT | 4GB_VA, with NO HAS_HW_APRIV, so the
+ *     NO_UPDATE variant is the correct one for this chip;
+ *   - therefore the completed-pointer must be read from the RPTR shadow, never
+ *     from CP_RB_RPTR.
+ *
+ * CP_RB_CNTL's two constants (MSM_GPU_RB_CNTL_DEFAULT and AXXX_CP_RB_CNTL_NO_UPDATE)
+ * are NOT in the pinned input set -- the symbol is used by a6xx_gpu.c but defined
+ * outside the files we pin -- so they are configuration inputs here. Inventing
+ * those bit patterns is exactly the kind of plausible-but-wrong constant this port
+ * refuses to hardcode; the ring init fails closed until the caller supplies them.
+ *
+ * SPDX-License-Identifier: MIT
+ */
+#ifndef NABU_GPU_RING_H
+#define NABU_GPU_RING_H
+
+#include <stdint.h>
+
+/* Register offsets come from the derived header; the build supplies it. */
+#include "NativeAdrenoA640HwInit.h"
+
+#define NABU_RING_UNVERIFIED 0u
+
+typedef struct nabu_gpu_ring_config {
+	uint64_t regs;              /* GPU register window base (virtual) */
+	uint64_t ring_iova;         /* ring buffer device address */
+	uint64_t ring_bytes;        /* power of two, CP_RB_BASE requires alignment */
+	uint64_t sqe_iova;          /* SQE microcode device address */
+	uint64_t rptr_shadow_iova;  /* 4-byte RPTR shadow */
+	uint32_t rb_cntl_default;   /* MSM_GPU_RB_CNTL_DEFAULT; 0 = not supplied */
+	uint32_t rb_cntl_no_update; /* AXXX_CP_RB_CNTL_NO_UPDATE; 0 = not supplied */
+	uint32_t int_mask;          /* A6XX_INT_MASK */
+} nabu_gpu_ring_config_t;
+
+typedef struct nabu_gpu_ring {
+	nabu_gpu_ring_config_t config;
+	volatile uint32_t *rptr_shadow;  /* host mapping of rptr_shadow_iova */
+	uint32_t wptr;                   /* last doorbell value, in dwords */
+	int ready;
+} nabu_gpu_ring_t;
+
+/* Returns 0 on success, EINVAL for a config the chip cannot accept (including the
+ * missing RB_CNTL constants), EBUSY when the GPU is not idle. */
+int nabu_gpu_ring_init(nabu_gpu_ring_t *ring, const nabu_gpu_ring_config_t *config);
+
+/* Ring the doorbell for `dwords` new commands (a6xx_gpu.c:182). */
+int nabu_gpu_ring_submit(nabu_gpu_ring_t *ring, uint32_t dwords);
+
+/* Poll the RPTR shadow until the CP has consumed `target` dwords
+ * (a6xx_gpu.c:2397: the register itself is not reliable on this generation). */
+int nabu_gpu_ring_wait(nabu_gpu_ring_t *ring, uint32_t target, unsigned timeout_us);
+
+#endif /* NABU_GPU_RING_H */
diff --git a/bsd/dev/nabu_gpucc.c b/bsd/dev/nabu_gpucc.c
new file mode 100644
index 0000000..e70d896
--- /dev/null
+++ b/bsd/dev/nabu_gpucc.c
@@ -0,0 +1,240 @@
+/*
+ * NABU GPUCC clock gates and the GPU/GMU clock table (Adreno 640, SM8150-AC).
+ *
+ * Scope: enable the clocks the GMU and the GPU need before any GPU register
+ * access. No clock framework, no parent/RCG rate programming yet -- the GMU runs
+ * at its boot rate and every frequency change is a later milestone.
+ *
+ * Register offsets are deliberately NOT written here. The CBCR offsets, halt bits
+ * and enable bits for gpucc-sm8150 come from the Linux clock driver
+ * (drivers/clk/qcom/gpucc-sm8150.c) and gcc-sm8150.c, both pinned, and are emitted
+ * by gpu/derive-gpucc-clocks.py and gpu/derive-gcc-clocks.py into the two generated
+ * headers included below. l3_vote is the one clock still unverified: its provider is
+ * cpucc, whose binding is a separate namespace. Any entry that has no pinned offset
+ * keeps NABU_*_UNVERIFIED and nabu_gpucc_clock_enable() refuses to program it, so a
+ * wrong address can never be written silently.
+ *
+ * SPDX-License-Identifier: MIT
+ */
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <machine/machine_routines.h>
+
+#include "NabuGpuBoard.h"
+#include "nabu_gpu.h"
+#include "NabuGpuccClocks.h"   /* generated: gpucc CBCR gates */
+#include "NabuGccClocks.h"    /* generated: gcc-side CBCR gates */
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+
+#define NABU_GPUCC_OFFSET_UNVERIFIED 0xFFFFFFFFu
+/* 512 KiB covers both gcc gates (0x7100c and 0x71154) with room to spare. */
+#define NABU_GCC_MAP_SIZE 0x80000u
+/* Both generated headers must agree on the sentinel; make that explicit. */
+#if NABU_GCC_UNVERIFIED != NABU_GPUCC_OFFSET_UNVERIFIED
+#error "gpucc/gcc generated headers disagree on the unverified sentinel"
+#endif
+
+typedef struct nabu_gpucc_clock {
+	const char *name;
+	unsigned int dt_id;             /* <provider id> cell from the device tree */
+	const char *provider;           /* "gpucc" | "gcc" | "cpucc" */
+	unsigned int cbcr_off;          /* NABU_GPUCC_OFFSET_UNVERIFIED until pinned */
+	unsigned int halt_bit;
+	unsigned int enable_bit;
+	unsigned int en_mask;           /* 0 -> CLK_ENABLE bit 0, BRANCH_HALT_SKIP when 0x10000 */
+} nabu_gpucc_clock_t;
+
+/*
+ * Order matters: AHB first (register access), then the bus clocks, then GMU and
+ * the always-on counter. The GPU's own power-on clock (gpu_cc_gx_gpu_clk) is left
+ * to the GDSC/GX stage in nabu_gpu_power.c.
+ */
+static nabu_gpucc_clock_t nabu_gpucc_clocks[] = {
+	{ "gpu_cc_ahb",   NABU_GMU_CLK_GPU_CC_AHB_ID,  "gpucc",
+	  NABU_GPUCC_GPU_GPU_CC_AHB_CBCR, 0, 0, NABU_GPUCC_GPU_GPU_CC_AHB_MASK },
+	{ "axi_clk",      NABU_GMU_CLK_AXI_CLK_ID,     "gcc",
+	  NABU_GCC_GMU_AXI_CLK_CBCR, 0, 0, NABU_GCC_GMU_AXI_CLK_MASK },
+	{ "memnoc_clk",   NABU_GMU_CLK_MEMNOC_CLK_ID,  "gcc",
+	  NABU_GCC_GMU_MEMNOC_CLK_CBCR, 0, 0, NABU_GCC_GMU_MEMNOC_CLK_MASK },
+	{ "gmu_clk",      NABU_GMU_CLK_GMU_CLK_ID,     "gpucc",
+	  NABU_GPUCC_GPU_GMU_CLK_CBCR, 0, 0, NABU_GPUCC_GPU_GMU_CLK_MASK },
+	{ "cxo_clk",      NABU_GMU_CLK_CXO_CLK_ID,     "gpucc",
+	  NABU_GPUCC_GMU_CXO_CLK_CBCR, 0, 0, NABU_GPUCC_GMU_CXO_CLK_MASK },
+	{ "rbbmtimer_clk", NABU_GPU_CLK_RBBMTIMER_CLK_ID, "gpucc",
+	  NABU_GPUCC_GPU_RBBMTIMER_CLK_CBCR, 0, 0, NABU_GPUCC_GPU_RBBMTIMER_CLK_MASK },
+	{ "mem_clk",      NABU_GPU_CLK_MEM_CLK_ID,     "gcc",
+	  NABU_GCC_GPU_MEM_CLK_CBCR, 0, 0, NABU_GCC_GPU_MEM_CLK_MASK },
+	{ "mem_iface_clk", NABU_GPU_CLK_MEM_IFACE_CLK_ID, "gcc",
+	  NABU_GCC_GPU_MEM_IFACE_CLK_CBCR, 0, 0, NABU_GCC_GPU_MEM_IFACE_CLK_MASK },
+};
+
+static vm_offset_t nabu_gpucc_base;
+static vm_offset_t nabu_gcc_base;      /* the four bus gates live in gcc */
+static unsigned int nabu_gpucc_enabled;
+
+/* Each entry names its provider, so the window is chosen from data, not index. */
+static vm_offset_t
+nabu_gpucc_clock_base(const nabu_gpucc_clock_t *clock)
+{
+	if (strcmp(clock->provider, "gcc") != 0) {
+		return nabu_gpucc_base;
+	}
+	if (nabu_gcc_base == 0) {
+		/* 2 MiB of gcc registers. Mapped on demand only: the read-only probe does
+		 * not need it, and the build that mapped it eagerly (v9) never reached the
+		 * console, so keep this off the early-boot path until a gate is gated. */
+		/* Only the two gates we need (0x7100c, 0x71154) have to be reachable;
+		 * mapping the whole 2 MiB window early buys nothing. */
+		printf("NABU GPUCC: mapping gcc %#x+%#x\n", NABU_GCC_REG_BASE,
+		    NABU_GCC_MAP_SIZE);
+		nabu_gcc_base = ml_io_map(NABU_GCC_REG_BASE, NABU_GCC_MAP_SIZE);
+	}
+	return nabu_gcc_base;
+}
+
+static unsigned int
+nabu_gpucc_verified(nabu_gpucc_clock_t *clock)
+{
+	return clock->cbcr_off != NABU_GPUCC_OFFSET_UNVERIFIED;
+}
+
+unsigned int
+nabu_gpucc_total_count(void)
+{
+	return (unsigned int)(sizeof(nabu_gpucc_clocks) / sizeof(nabu_gpucc_clocks[0]));
+}
+
+int
+nabu_gpucc_init(void)
+{
+	printf("NABU GPUCC: init (%u clocks)\n", nabu_gpucc_total_count());
+	if (nabu_gpucc_base != 0) {
+		return 0;
+	}
+	nabu_gpucc_base = ml_io_map(NABU_GPUCC_REG_BASE, NABU_GPUCC_REG_SIZE);
+	if (nabu_gpucc_base == 0) {
+		printf("NABU GPUCC: cannot map clock controller at %#x\n", NABU_GPUCC_REG_BASE);
+		return ENOMEM;
+	}
+/* The gcc window is mapped on demand: see nabu_gpucc_clock_base(). */
+	printf("NABU GPUCC: mapped %#x+%#x and gcc %#x+%#x, %u clocks (%u pinned)\n",
+	    NABU_GPUCC_REG_BASE, NABU_GPUCC_REG_SIZE, NABU_GCC_REG_BASE,
+	    NABU_GCC_REG_SIZE, nabu_gpucc_total_count(),
+	    nabu_gpucc_verified_count());
+	return 0;
+}
+
+unsigned int
+nabu_gpucc_verified_count(void)
+{
+	unsigned int verified = 0;
+	for (unsigned int i = 0; i < nabu_gpucc_total_count(); i++) {
+		verified += nabu_gpucc_verified(&nabu_gpucc_clocks[i]) ? 1 : 0;
+	}
+	return verified;
+}
+
+int
+nabu_gpucc_clock_enable(const char *name)
+{
+	if (nabu_gpucc_base == 0) {
+		return ENXIO;
+	}
+	for (unsigned int i = 0; i < nabu_gpucc_total_count(); i++) {
+		nabu_gpucc_clock_t *clock = &nabu_gpucc_clocks[i];
+		if (strcmp(clock->name, name) != 0) {
+			continue;
+		}
+		if (!nabu_gpucc_verified(clock)) {
+			/* Refuse rather than write an unverified CBCR address. */
+			printf("NABU GPUCC: %s has no pinned CBCR offset; not programmed\n", name);
+			return ENOTSUP;
+		}
+		vm_offset_t base = nabu_gpucc_clock_base(clock);
+		if (base == 0) {
+			printf("NABU GPUCC: %s lives in an unmapped window; not programmed\n", name);
+			return ENXIO;
+		}
+		unsigned int value = *(volatile unsigned int *)(base + clock->cbcr_off);
+		value |= (clock->en_mask != 0) ? clock->en_mask : (1u << clock->enable_bit);
+		*(volatile unsigned int *)(base + clock->cbcr_off) = value;
+		/* Halt polling is deferred until the halt bit table is pinned too. */
+		nabu_gpucc_enabled++;
+		printf("NABU GPUCC: %s enabled (cbcr %#x)\n", name, clock->cbcr_off);
+		return 0;
+	}
+	printf("NABU GPUCC: unknown clock %s\n", name);
+	return ENOENT;
+}
+
+int
+nabu_gpucc_enable_gmu_set(void)
+{
+	static const char *const order[] = {
+		"gpu_cc_ahb", "axi_clk", "memnoc_clk", "gmu_clk", "cxo_clk",
+	};
+	for (unsigned int i = 0; i < sizeof(order) / sizeof(order[0]); i++) {
+		int error = nabu_gpucc_clock_enable(order[i]);
+		if (error) {
+			return error;
+		}
+	}
+	return 0;
+}
+
+void
+nabu_gpucc_report(void)
+{
+	printf("NABU GPUCC: %u clock entries, %u verified, %u enabled\n",
+	    nabu_gpucc_total_count(), nabu_gpucc_verified_count(), nabu_gpucc_enabled);
+	for (unsigned int i = 0; i < nabu_gpucc_total_count(); i++) {
+		nabu_gpucc_clock_t *clock = &nabu_gpucc_clocks[i];
+		printf("NABU GPUCC:   %-16s dt_id=%2u provider=%-5s %s\n", clock->name, clock->dt_id,
+		    clock->provider,
+		    nabu_gpucc_verified(clock) ? "pinned" : "OFFSET UNVERIFIED");
+	}
+}
+
+/* Gate all eight clocks. Each failure names the clock that refused. */
+int
+nabu_gpucc_enable_all(void)
+{
+	unsigned int done = 0;
+
+	for (unsigned int i = 0; i < nabu_gpucc_total_count(); i++) {
+		int error = nabu_gpucc_clock_enable(nabu_gpucc_clocks[i].name);
+		if (error) {
+			printf("NABU GPUCC: %u/%u gated, %s failed (%d)\n", done,
+			    nabu_gpucc_total_count(), nabu_gpucc_clocks[i].name, error);
+			return error;
+		}
+		done++;
+	}
+	printf("NABU GPUCC: %u/%u clock gates enabled\n", done, nabu_gpucc_total_count());
+	return 0;
+}
+
+/*
+ * Read every CBCR back. A wrong offset shows up here as a register that did not
+ * change, which is the only way to notice it before the GPU is asked to run.
+ */
+void
+nabu_gpucc_dump(void)
+{
+	for (unsigned int i = 0; i < nabu_gpucc_total_count(); i++) {
+		nabu_gpucc_clock_t *clock = &nabu_gpucc_clocks[i];
+		vm_offset_t base = nabu_gpucc_clock_base(clock);
+
+		if (!nabu_gpucc_verified(clock) || base == 0) {
+			printf("NABU GPUCC:   %-16s cbcr %#x not readable\n", clock->name,
+			    clock->cbcr_off);
+			continue;
+		}
+		unsigned int value = *(volatile unsigned int *)(base + clock->cbcr_off);
+		printf("NABU GPUCC:   %-16s cbcr %#x = %#x %s\n", clock->name,
+		    clock->cbcr_off, value,
+		    (clock->en_mask != 0 && (value & clock->en_mask)) ? "ENABLED" : "off");
+	}
+}
diff --git a/bsd/dev/nabu_rpmh_gpu.c b/bsd/dev/nabu_rpmh_gpu.c
new file mode 100644
index 0000000..39f97c4
--- /dev/null
+++ b/bsd/dev/nabu_rpmh_gpu.c
@@ -0,0 +1,184 @@
+/*
+ * NABU RPMh votes for the GPU: ARC level rails (cxlvl / gfxlvl) and the cnoc bus vote.
+ *
+ * Transport is nabu_rpmh.c's: the same RSC, ACTIVE TCS bank and cmd-db. Only the
+ * payload differs from the PMIC5 LDO path, so this file owns exactly that and
+ * nothing else.
+ *
+ * On the slave id: the cmd-db entry already carries it in address bits [19:16]
+ * (that is how the LDO path validates RH_VRM), so a lookup with want_slave == 0
+ * accepts any slave and reports which one matched. The probe below therefore needs
+ * no prior knowledge of the ids -- it discovers them.
+ *
+ * Still unknown, and therefore gated: the *payload encoding* of an ARC level vote
+ * (Linux: drivers/soc/qcom/rpmh-regulator.c) and of a BCM bus vote
+ * (drivers/interconnect/qcom/bcm-voter.c). Neither is in the pinned input set, so
+ * while a gate is closed the vote returns ENOTSUP and writes nothing.
+ *
+ * SPDX-License-Identifier: MIT
+ */
+#if defined(ARM64_BOARD_CONFIG_NABU)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+#include <kern/startup.h>
+#include "NabuGpuBoard.h"   /* NABU_RPMH_RES_* live here */
+
+/* nabu_rpmh.c */
+/* Defined by bsd/dev/nabu_rpmh.c (patch 0109); declared here for the GPU side. */
+int nabu_rpmh_lookup(const char *res, unsigned slave, uint32_t *address);
+int nabu_rpmh_send_raw(const char *res, unsigned slave, const uint32_t *offsets,
+    const uint32_t *values, unsigned count);
+
+#include "nabu_gpu.h"
+
+/* Verified against qcom-rpmh-regulator.c: an ARC/VRM vote is ONE tcs_cmd at
+ * vreg->addr + RPMH_REGULATOR_REG_VRM_VOLTAGE (0x0) carrying the level
+ * (:178 builds it, :184 fills cmd.data). The same table's 0x4/0x8 offsets are
+ * what nabu_rpmh.c already sends as its LDO triple {0,8,4}. */
+#define NABU_ARC_ENCODING_VERIFIED 1
+/* Verified against include/soc/qcom/tcs.h (a pinned input) and
+ * bcm-voter.c:147, which builds cmd->data = BCM_TCS_CMD(commit, valid, x, y):
+ *   COMMIT bit 30, VALID bit 29, vote_x << 14 (average), vote_y << 0 (peak),
+ *   both votes masked to 0x3fff. */
+#define NABU_BCM_ENCODING_VERIFIED 1
+#define NABU_BCM_COMMIT_SHIFT 30
+#define NABU_BCM_VALID_SHIFT  29
+#define NABU_BCM_VOTE_X_SHIFT 14
+#define NABU_BCM_VOTE_MASK    0x3fffu
+
+/* ARC vote payload: level only (retention 0 .. max). Encoding unverified. */
+static uint32_t
+nabu_arc_payload(unsigned level)
+{
+	/* qcom-rpmh-regulator.c:184 -- the vote carries the selector/level itself */
+	return level;
+}
+
+/* BCM vote payload: AB/IB pair packed into one dword. Encoding unverified. */
+static uint32_t
+nabu_bcm_payload(unsigned ab_kbps, unsigned ib_kbps)
+{
+	/* average bandwidth in the vote_x field, peak in vote_y (bcm-voter.c:102-115) */
+	uint32_t vote_x = ab_kbps & NABU_BCM_VOTE_MASK;
+	uint32_t vote_y = ib_kbps & NABU_BCM_VOTE_MASK;
+	return (1u << NABU_BCM_COMMIT_SHIFT) | (1u << NABU_BCM_VALID_SHIFT) |
+	    (vote_x << NABU_BCM_VOTE_X_SHIFT) | vote_y;
+}
+
+int
+nabu_rpmh_arc_vote(const char *resource, unsigned level)
+{
+	if (!NABU_ARC_ENCODING_VERIFIED) {
+		printf("NABU RPMH: ARC vote %s=%u skipped (payload encoding unverified)\n",
+		    resource ? resource : "?", level);
+		return ENOTSUP;
+	}
+	/* RPMH_REGULATOR_REG_VRM_VOLTAGE == 0x0 (qcom-rpmh-regulator.c:34) */
+	static const uint32_t offsets[1] = {0x0};
+	const uint32_t values[1] = {nabu_arc_payload(level)};
+	/* slave 0: take whichever slave the cmd-db entry reports */
+	return nabu_rpmh_send_raw(resource, 0, offsets, values, 1);
+}
+
+int
+nabu_rpmh_bus_vote(unsigned master, unsigned slave, unsigned ab_kbps, unsigned ib_kbps)
+{
+	if (!NABU_BCM_ENCODING_VERIFIED) {
+		printf("NABU RPMH: bus vote m%u->s%u ib=%u KBps skipped (payload encoding unverified)\n",
+		    master, slave, ib_kbps);
+		return ENOTSUP;
+	}
+	/* The BCM resource name comes from the bus node ("cnoc" in the nabu DTB). */
+	static const char *const resource = "cnoc";
+	static const uint32_t offsets[1] = {0};
+	const uint32_t values[1] = {nabu_bcm_payload(ab_kbps, ib_kbps)};
+	return nabu_rpmh_send_raw(resource, 0, offsets, values, 1);
+}
+
+/*
+ * Read-only discovery: resolve the three resources and report address plus the
+ * slave id the cmd-db carries. No TCS is touched here.
+ */
+/*
+ * One lookup, one line. Slave 0 means "whichever slave the cmd-db reports"; the
+ * answer is printed as slave=(address>>16)&0xf, which is where the id lives.
+ */
+static void
+nabu_rpmh_probe_one(const char *res)
+{
+	uint32_t address = 0;
+	int error = nabu_rpmh_lookup(res, 0, &address);
+
+	if (error) {
+		printf("NABU RPMH:   %-12s unresolved (errno %d)\n", res, error);
+	} else {
+		printf("NABU RPMH:   %-12s address=%#x slave=%u\n", res, address,
+		    (address >> 16) & 0xfu);
+	}
+}
+
+void
+nabu_rpmh_gpu_probe(void)
+{
+	/*
+	 * ARC rails are named by the DT. The BCM/bus resource is not: the ad-hoc bus
+	 * only names its own icc nodes (bcm_cn0 ...), so the spelling cmd-db carries
+	 * has to be measured, not guessed.
+	 */
+	/* qcom,bcm-name in the nabu DTB is uppercase (SN0/CN0/...); every lowercase
+	 * spelling tried in the previous run missed. */
+	static const char *const bcm_candidates[] = {
+		"ACV", "ALC", "MC0", "SH0", "MM0", "MM1",
+		"SH2", "MM2", "SH3", "MM3", "SH4", "SH5",
+		"SN0", "CO0", "CE0", "SN1", "CO1", "IP0",
+		"CN0", "QUP0", "SN2", "SN3", "SN4", "SN5",
+		"SN8", "SN9", "SN11", "SN12", "SN14", "SN15",
+	};
+	printf("NABU RPMH: GPU probe -- cmd-db resolution (read only)\n");
+	nabu_rpmh_probe_one(NABU_RPMH_RES_CXLVL);
+	nabu_rpmh_probe_one(NABU_RPMH_RES_GFXLVL);
+	printf("NABU RPMH:   -- BCM/bus candidates --\n");
+	for (unsigned r = 0; r < sizeof(bcm_candidates) / sizeof(bcm_candidates[0]); ++r) {
+		nabu_rpmh_probe_one(bcm_candidates[r]);
+	}
+}
+
+/*
+ * Boot hook: gated by the nagpuprobe boot-arg so an ordinary boot stays byte-for-byte
+ * as quiet as before. Called from the nabu_ufs init path, after the console ring is
+ * running, so the output survives into nabulog.
+ */
+void
+nabu_gpu_probe_boot(void)
+{
+	int enabled = 0;
+	(void)PE_parse_boot_argn("nabugpuprobe", &enabled, sizeof(enabled));
+	if (!enabled) {
+		return;
+	}
+	printf("NABU GPU: probe requested via nabugpuprobe=%d\n", enabled);
+	if (enabled >= 2) {
+		/* Staged write first: the read-only inventory below is the slowest part of
+		 * the log and would push this output off screen. */
+		unsigned int steps = NABU_GPU_STEP_CLOCKS;
+
+		printf("NABU GPU: ===== staged write begin =====\n");
+		if (enabled >= 3) {
+			steps |= NABU_GPU_STEP_ARC;
+		}
+		(void)nabu_gpu_steps(steps);
+		printf("NABU GPU: ===== staged write end =====\n");
+		return;
+	}
+	nabu_gpu_power_probe();
+	nabu_gpucc_report();
+}
+
+/* nabu_ufs.c used to call this, but that file is entangled with patches 0107/0108
+ * that never apply. Registering here keeps the GPU patch set self-contained;
+ * nabu_gpu_probe_boot() no-ops unless boot-arg nabugpuprobe=1 is set. */
+STARTUP(EARLY_BOOT, STARTUP_RANK_LAST, nabu_gpu_probe_boot);
+#endif /* ARM64_BOARD_CONFIG_NABU */
diff --git a/bsd/dev/NabuGccClocks.h b/bsd/dev/NabuGccClocks.h
new file mode 100644
index 0000000..c0ffee0
--- /dev/null
+++ b/bsd/dev/NabuGccClocks.h
@@ -0,0 +1,27 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef NABU_GCC_CLOCKS_H
+#define NABU_GCC_CLOCKS_H
+
+/* Generated by gpu/derive-gcc-clocks.py from
+ *   include/dt-bindings/clock/qcom,gcc-sm8150.h
+ *   drivers/clk/qcom/gcc-sm8150.c
+ *   gpu/nabu-gpu-board.json
+ * pinned at commit=21a7f44fd0765fcc5194130b28767786eba1d1e7
+ * The gcc window is the nabu DTB's /soc/qcom,gcc reg. Do not edit. */
+
+#define NABU_GCC_UNVERIFIED 0xFFFFFFFFu
+#define NABU_GCC_REG_BASE 0x00100000u
+#define NABU_GCC_REG_SIZE 0x001f0000u
+
+#define NABU_GCC_GPU_MEM_CLK_CBCR 0x71154u   /* gcc_ddrss_gpu_axi_clk, dt id 19, GCC_DDRSS_GPU_AXI_CLK */
+#define NABU_GCC_GPU_MEM_CLK_MASK 0x00000001u
+#define NABU_GCC_GPU_MEM_IFACE_CLK_CBCR 0x7100cu   /* gcc_gpu_memnoc_gfx_clk, dt id 40, GCC_GPU_MEMNOC_GFX_CLK */
+#define NABU_GCC_GPU_MEM_IFACE_CLK_MASK 0x00000001u
+#define NABU_GCC_GPU_L3_VOTE_CBCR NABU_GCC_UNVERIFIED   /* dt id 4: provider qcom,cpucc is not gcc */
+#define NABU_GCC_GPU_L3_VOTE_MASK 0u
+#define NABU_GCC_GMU_AXI_CLK_CBCR 0x71154u   /* gcc_ddrss_gpu_axi_clk, dt id 19, GCC_DDRSS_GPU_AXI_CLK */
+#define NABU_GCC_GMU_AXI_CLK_MASK 0x00000001u
+#define NABU_GCC_GMU_MEMNOC_CLK_CBCR 0x7100cu   /* gcc_gpu_memnoc_gfx_clk, dt id 40, GCC_GPU_MEMNOC_GFX_CLK */
+#define NABU_GCC_GMU_MEMNOC_CLK_MASK 0x00000001u
+
+#endif /* NABU_GCC_CLOCKS_H */
