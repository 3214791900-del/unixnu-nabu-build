+/*
+ * CDC-ACM serial: the host (Windows usbser, Linux cdc_acm) reads the kernel
+ * console through the bulk IN endpoint.  This is the only host-readable log
+ * channel on the device - there is no adb, UART or network gadget.
+ */
+static char ud_ser_buf[4096];
+static int ud_ser_len;
+static bool ud_ser_busy;
+
+void
+nabu_usb_serial_write(const char *buf, int len)
+{
+	if (!ud.configured || buf == NULL || len <= 0) {
+		return;
+	}
+	lck_mtx_lock(ud.lock);
+	int space = (int)sizeof(ud_ser_buf) - ud_ser_len;
+	if (len > space) {
+		len = space;
+	}
+	if (len > 0) {
+		memcpy(ud_ser_buf + ud_ser_len, buf, (size_t)len);
+		ud_ser_len += len;
+	}
+	ud_ser_kick_locked();
+	lck_mtx_unlock(ud.lock);
+}
