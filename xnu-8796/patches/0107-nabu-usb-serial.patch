+/*
+ * Only the lines worth reading when the panel is the only output: the
+ * display stack, the accelerator, IOKit matching and crashes.  Everything
+ * else in the ring is daemon spam (one exec line per spawn, one AKS line per
+ * key-store call) and would bury them.
+ */
+extern void fbcon_freeze(void);
+
+static int
+nabu_log_keep(const char *line)
+{
+	/*
+	 * nabudump_accel=1 narrows the dump to the accelerator and crashes: the
+	 * IOKit matching lines are ~200 characters each and flood the panel, so
+	 * the ACCEL lines ("registered", "user client OPENED by ...") get
+	 * scrolled away before they can be read.
+	 */
+	static int accel_only = -1;
+	static const char *const accel[] = { "NABU ACCEL:", "CRASH ", "panic", ": open " };
+	static const char *const want[] = {
+		"NABU FB:", "NABU SURF:", "NABU SCALER:", "NABU ACCEL:",
+		"IOK backboardd", "matching1", "CRASH ", "panic",
+	};
+	size_t i;
+
+	if (accel_only < 0) {
+		int v = 0;
+		accel_only = PE_parse_boot_argn("nabudump_accel", &v, sizeof(v)) && v;
+	}
+	if (accel_only) {
+		for (i = 0; i < sizeof(accel) / sizeof(accel[0]); i++) {
+			if (strnstr(line, accel[i], strlen(line)) != NULL) {
+				return 1;
+			}
+		}
+		return 0;
+	}
+
+	for (i = 0; i < sizeof(want) / sizeof(want[0]); i++) {
+		if (strnstr(line, want[i], strlen(line)) != NULL) {
+			return 1;
+		}
+	}
+	return 0;
+}
