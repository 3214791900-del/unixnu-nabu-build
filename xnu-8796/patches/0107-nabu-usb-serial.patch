 /* Start the next queued frame if the IN endpoint is idle. ud.lock held. */
+static void
+ud_ser_kick_locked(void)
+{
+	if (ud_ser_busy || ud_ser_len <= 0 || !ud.configured) {
+		return;
+	}
+	int n = ud_ser_len > 512 ? 512 : ud_ser_len;
+	memcpy((void *)(ud.dma + UD_TX), ud_ser_buf, (size_t)n);
+	memmove(ud_ser_buf, ud_ser_buf + n, (size_t)(ud_ser_len - n));
+	ud_ser_len -= n;
+	ud_ser_busy = true;
+	ud_start_trb(EP_TX, UD_TRB_TX, UD_TX, (uint32_t)n, TRBCTL_NORMAL);
+}
