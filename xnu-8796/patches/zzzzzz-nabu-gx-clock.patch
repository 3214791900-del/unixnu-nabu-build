+/*
+ * The GX rail's GDSC is deliberately not written, independently of the CX gate.
+ *
+ * Linux gives gpu_gx_gdsc its own power_on, gdsc_gx_do_nothing_enable(), plus
+ * CLAMP_IO | AON_RESET | POLL_CFG_GDSCR (gpucc-sm8150.c, the gpu_gx_gdsc block).
+ * That override exists because the GX domain is not switched on by poking GDSCR
+ * from the AP: the clock and the ARC vote lift it, and the GMU owns it after that.
+ * Writing GDSCR there is what froze the tablet on 2026-10-26 -- screen stopped,
+ * no panic printed, which is what an AP access to a clamp-held domain looks like.
+ *
+ * Keep this 0. Set it to 1 only when a run has proved the write safe here.
+ */
+#define NABU_GX_GDSC_WRITE       0
+
