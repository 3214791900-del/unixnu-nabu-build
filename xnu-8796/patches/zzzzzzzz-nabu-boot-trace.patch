diff --git a/iokit/bsddev/IOKitBSDInit.cpp b/iokit/bsddev/IOKitBSDInit.cpp
index 578a118..ffde9c6 100644
--- a/iokit/bsddev/IOKitBSDInit.cpp
+++ b/iokit/bsddev/IOKitBSDInit.cpp
@@ -128,6 +128,44 @@ IOServicePublishResource( const char * property, boolean_t value )
 	}
 }
 
+#if defined(NABU)
+/*
+ * Which of the services a graphics stack needs actually exist in the registry?
+ * The userland goes quiet once the boot finishes, so the kernel has to answer
+ * this: backboardd can only draw if it finds a framebuffer and an accelerator.
+ */
+extern "C" void nabu_dump_gfx_services(void);
+
+void
+nabu_dump_gfx_services(void)
+{
+	static const char *const names[] = {
+		"AGXAccelerator",
+		"AGXAcceleratorG9",
+		"AppleMobileFramebuffer",
+		"IOMobileFramebuffer",
+		"IOCoreSurfaceRoot",
+		"AppleCLCD",
+	};
+
+	for (size_t i = 0; i < sizeof(names) / sizeof(names[0]); i++) {
+		OSDictionary *dict = IOService::serviceMatching(names[i]);
+		IOService *match = NULL;
+
+		if (dict) {
+			match = IOService::waitForMatchingService(dict, 100ULL * 1000 * 1000);
+			dict->release();
+		}
+		if (match) {
+			kprintf("NABU GFX: %s present open=%d\n", names[i], (int)match->isOpen(NULL));
+			match->release();
+		} else {
+			kprintf("NABU GFX: %s absent\n", names[i]);
+		}
+	}
+}
+#endif
+
 boolean_t
 IOServiceWaitForMatchingResource( const char * property, uint64_t timeout )
 {
@@ -683,10 +721,19 @@ IOFindBSDRoot( char * rootName, unsigned int rootNameSize,
 	assert(matching);
 	matching->setObject(gIOResourceMatchedKey, gIOBSDKey);
 
+#if defined(NABU)
+	IOLog("NABU ROOT: IOFindBSDRoot enter\n");
+#endif
 	if ((service = IOService::waitForMatchingService(matching, 30ULL * kSecondScale))) {
 		OSSafeReleaseNULL(service);
+#if defined(NABU)
+		IOLog("NABU ROOT: IOBSD resource matched\n");
+#endif
 	} else {
 		IOLog("!BSD\n");
+#if defined(NABU)
+		IOLog("NABU ROOT: IOBSD resource NOT matched (30 s timeout)\n");
+#endif
 	}
 	matching->release();
 	matching = NULL;
