  * used like any other.
  */
+#if defined(NABU)
+extern kern_return_t kernel_thread_start(thread_continue_t, void *, thread_t *);
+extern void nabu_dump_gfx_services(void);
+
+/*
+ * Heartbeat plus a graphics-relevant census.  The panel is the only output
+ * channel and userland writes do not reach it reliably, so this is the only
+ * way to see how far the userspace has come once the boot goes quiet.
+ *
+ * Every five seconds print a heartbeat; every thirtieth second also report the
+ * live process count and whether the four processes that stand between us and
+ * a picture are running yet.
+ */
+static void
+nabu_heartbeat(void *arg, wait_result_t result)
+{
+	(void)arg;
+	(void)result;
+	int tick = 0;
+
+	for (;;) {
+		IOSleep(5000);
+		tick++;
+		kprintf("NABU ALIVE %d\n", tick);
+
+		if ((tick % 6) == 0) {
+			proc_t p;
+			int total = 0;
+			int bb = 0, sb = 0, ws = 0, rb = 0;
+
+			proc_list_lock();
+			LIST_FOREACH(p, &allproc, p_list) {
+				total++;
+				if (strncmp(p->p_comm, "backboardd", 10) == 0) {
+					bb = 1;
+				}
+				if (strncmp(p->p_comm, "SpringBoard", 11) == 0) {
+					sb = 1;
+				}
+				if (strncmp(p->p_comm, "WindowServer", 12) == 0) {
+					ws = 1;
+				}
+				if (strncmp(p->p_comm, "runningboardd", 13) == 0) {
+					rb = 1;
+				}
+			}
+			proc_list_unlock();
+
+			kprintf("NABU CENSUS: procs=%d backboardd=%d springboard=%d windowserver=%d runningboard=%d\n",
+			    total, bb, sb, ws, rb);
+			nabu_dump_gfx_services();
+		}
+	}
+}
+#endif
