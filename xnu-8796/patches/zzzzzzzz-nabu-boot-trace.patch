 #include <machine/pal_routines.h>
 #include <console/video_console.h>
 
@@ -473,6 +476,758 @@ bsd_rooted_ramdisk(void)
  * of the tro_ucred field so that the uthread structure can be
  * used like any other.
  */
+#if defined(NABU)
+#include "nabu_gmu_fw.h"
+#include "../dev/smmu/ArmSmmu4K.h"
+#include "../dev/smmu/ArmSmmu4KMmio.h"
+#include "../dev/smmu/ArmSmmu4KStreams.h"
+
+extern vm_offset_t ml_vtophys(vm_offset_t);
+
+/*
+ * Adreno 640 GMU microcode: decode, then plan the load the same way
+ * UniXNU's kits/AdrenoFirmware does -- a block is { address, length, type,
+ * value } followed by length bytes of payload, from offset 0 of the image.
+ * Nothing here touches the GPU yet; it only proves the image decodes and that
+ * every block lands where the firmware asks.
+ */
+static int
+nabu_b64val(char c)
+{
+	if (c >= 'A' && c <= 'Z') {
+		return c - 'A';
+	}
+	if (c >= 'a' && c <= 'z') {
+		return c - 'a' + 26;
+	}
+	if (c >= '0' && c <= '9') {
+		return c - '0' + 52;
+	}
+	if (c == '+') {
+		return 62;
+	}
+	if (c == '/') {
+		return 63;
+	}
+	return -1;
+}
+
+static void
+nabu_gmu_fw_probe(void)
+{
+	static uint8_t image[NABU_GMU_FW_BYTES];
+	const char *s = nabu_gmu_fw_b64;
+	size_t out = 0;
+	uint32_t acc = 0;
+	int bits = 0;
+
+	for (; *s != 0; s++) {
+		int v = nabu_b64val(*s);
+
+		if (v < 0) {
+			continue;       /* '=' padding and whitespace */
+		}
+		acc = (acc << 6) | (uint32_t)v;
+		bits += 6;
+		if (bits >= 8) {
+			bits -= 8;
+			if (out < sizeof(image)) {
+				image[out++] = (uint8_t)(acc >> bits);
+			}
+		}
+	}
+	if (out != NABU_GMU_FW_BYTES) {
+		kprintf("NABU GMU FW: decoded %u of %u bytes\n",
+		    (unsigned)out, (unsigned)NABU_GMU_FW_BYTES);
+		return;
+	}
+	kprintf("NABU GMU FW: decoded %u bytes\n", (unsigned)out);
+
+	size_t off = 0;
+	uint32_t blocks = 0, mapped = 0, highest = 0;
+
+	while (off + 16 <= sizeof(image)) {
+		const uint8_t *b = image + off;
+		uint32_t addr = (uint32_t)b[0] | (uint32_t)b[1] << 8 |
+		    (uint32_t)b[2] << 16 | (uint32_t)b[3] << 24;
+		uint32_t len = (uint32_t)b[4] | (uint32_t)b[5] << 8 |
+		    (uint32_t)b[6] << 16 | (uint32_t)b[7] << 24;
+
+		if (len > sizeof(image) - off - 16) {
+			kprintf("NABU GMU FW: block %u truncated\n", blocks);
+			break;
+		}
+		kprintf("NABU GMU FW: block %u addr %#x len %#x\n",
+		    blocks, addr, len);
+		if (addr + len > highest) {
+			highest = addr + len;
+		}
+		mapped += len;
+		blocks++;
+		off += 16 + len;
+	}
+	kprintf("NABU GMU FW: %u block(s), %u payload bytes, highest %#x, end %#x of %#x\n",
+	    blocks, mapped, highest, (uint32_t)off, (uint32_t)sizeof(image));
+
+	/*
+	 * Reserve one physically contiguous window wide enough for the highest
+	 * address the firmware asks for, then copy every block to its own offset.
+	 * This is the memory the GPU will later see through the SMMU; nothing is
+	 * handed to the hardware yet, so the only claim being made is that the
+	 * image fits and the copy round-trips.
+	 */
+	{
+		extern kern_return_t kmem_alloc_contig(vm_map_t, vm_offset_t *,
+		    vm_size_t, vm_offset_t, ppnum_t, ppnum_t, kma_flags_t,
+		    vm_tag_t);
+		extern vm_map_t kernel_map;
+		vm_size_t size = 0x80000;        /* 512 KB: 0x0 .. 0x7ffff */
+		vm_offset_t va = 0;
+		kern_return_t kr = kmem_alloc_contig(kernel_map, &va, size, 0, 0, 0, 0,
+		    VM_KERN_MEMORY_IOKIT);
+
+		if (kr != KERN_SUCCESS || va == 0) {
+			kprintf("NABU GMU MEM: kmem_alloc_contig failed %d\n", (int)kr);
+			return;
+		}
+
+		uint8_t *dst = (uint8_t *)va;
+		bzero(dst, size);
+		size_t copy = 0;
+		for (size_t at = 0; at + 16 <= sizeof(image);) {
+			const uint8_t *b = image + at;
+			uint32_t addr = (uint32_t)b[0] | (uint32_t)b[1] << 8 |
+			    (uint32_t)b[2] << 16 | (uint32_t)b[3] << 24;
+			uint32_t len = (uint32_t)b[4] | (uint32_t)b[5] << 8 |
+			    (uint32_t)b[6] << 16 | (uint32_t)b[7] << 24;
+
+			if (len == 0 || (size_t)addr + len > size) {
+				break;
+			}
+			bcopy(b + 16, dst + addr, len);
+			copy += len;
+			at += 16 + len;
+		}
+
+		/* verify every block byte for byte instead of sampling one word */
+		size_t bad = 0, checked = 0;
+		for (size_t at = 0; at + 16 <= sizeof(image);) {
+			const uint8_t *b = image + at;
+			uint32_t addr = (uint32_t)b[0] | (uint32_t)b[1] << 8 |
+			    (uint32_t)b[2] << 16 | (uint32_t)b[3] << 24;
+			uint32_t len = (uint32_t)b[4] | (uint32_t)b[5] << 8 |
+			    (uint32_t)b[6] << 16 | (uint32_t)b[7] << 24;
+
+			if (len == 0 || (size_t)addr + len > size) {
+				break;
+			}
+			if (memcmp(b + 16, dst + addr, len) != 0) {
+				bad++;
+			}
+			checked += len;
+			at += 16 + len;
+		}
+		kprintf("NABU GMU MEM: va %p size %#llx copied %u\n",
+		    (void *)va, (unsigned long long)size, (unsigned)copy);
+		kprintf("NABU GMU MEM: verified %u bytes, %u block(s) differ\n",
+		    (unsigned)checked, (unsigned)bad);
+
+		/*
+		 * The GMU own code memory is reachable through registers, so the
+		 * blocks the firmware wants inside the first 16K can be delivered
+		 * without the SMMU at all.
+		 */
+		{
+			extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+			vm_offset_t gv;
+			volatile uint32_t *itcm;
+			volatile uint32_t *dtcm;
+			size_t at;
+			unsigned loaded, mismatch;
+
+			gv = ml_io_map(0x02c6a000, 0x34000);
+			loaded = 0;
+			mismatch = 0;
+			at = 0;
+			if (gv == 0) {
+				kprintf("NABU GMU ITCM: map failed\n");
+			} else {
+				itcm = (volatile uint32_t *)(gv + 0x3000);
+				dtcm = (volatile uint32_t *)(gv + 0x7000);
+				while (at + 16 <= sizeof(image)) {
+					const uint8_t *b = image + at;
+					uint32_t addr = (uint32_t)b[0] | (uint32_t)b[1] << 8 |
+					    (uint32_t)b[2] << 16 | (uint32_t)b[3] << 24;
+					uint32_t len = (uint32_t)b[4] | (uint32_t)b[5] << 8 |
+					    (uint32_t)b[6] << 16 | (uint32_t)b[7] << 24;
+					uint32_t off;
+					const uint8_t *p;
+
+					if (len == 0 || (size_t)addr + len > size) {
+						break;
+					}
+					if (addr + len <= 0x4000u) {
+						p = b + 16;
+						for (off = 0; off + 4 <= len; off += 4) {
+							uint32_t w = (uint32_t)p[0];
+							w |= (uint32_t)p[1] << 8;
+							w |= (uint32_t)p[2] << 16;
+							w |= (uint32_t)p[3] << 24;
+							itcm[(addr + off) / 4] = w;
+							p += 4;
+						}
+						__asm__ volatile("dsb sy" ::: "memory");
+						p = b + 16;
+						for (off = 0; off + 4 <= len; off += 4) {
+							uint32_t want = (uint32_t)p[0];
+							want |= (uint32_t)p[1] << 8;
+							want |= (uint32_t)p[2] << 16;
+							want |= (uint32_t)p[3] << 24;
+							if (itcm[(addr + off) / 4] != want) {
+								mismatch++;
+							}
+							p += 4;
+						}
+						loaded += len;
+						nabu_gmu_itcm_bytes += len;
+						kprintf("NABU GMU ITCM: block %#x len %#x loaded\n",
+						    addr, len);
+					} else if (addr >= 0x40000u && addr + len <= 0x44000u) {
+						/*
+						 * a640 keeps the firmware's data segment at 0x40000 in
+						 * block addresses, which lands in the GMU's own 16K of
+						 * data memory.  Without it the firmware starts with no
+						 * data at all.
+						 */
+						p = b + 16;
+						for (off = 0; off + 4 <= len; off += 4) {
+							uint32_t w = (uint32_t)p[0];
+
+							w |= (uint32_t)p[1] << 8;
+							w |= (uint32_t)p[2] << 16;
+							w |= (uint32_t)p[3] << 24;
+							dtcm[(addr - 0x40000u + off) / 4] = w;
+							p += 4;
+						}
+						__asm__ volatile("dsb sy" ::: "memory");
+						p = b + 16;
+						for (off = 0; off + 4 <= len; off += 4) {
+							uint32_t want = (uint32_t)p[0];
+
+							want |= (uint32_t)p[1] << 8;
+							want |= (uint32_t)p[2] << 16;
+							want |= (uint32_t)p[3] << 24;
+							if (dtcm[(addr - 0x40000u + off) / 4] != want) {
+								mismatch++;
+							}
+							p += 4;
+						}
+						loaded += len;
+						nabu_gmu_dtcm_bytes += len;
+						kprintf("NABU GMU DTCM: block %#x len %#x loaded\n",
+						    addr, len);
+					}
+					at += 16 + len;
+				}
+				kprintf("NABU GMU ITCM: %u bytes in, %u word(s) differ\n",
+				    loaded, mismatch);
+			}
+		}
+
+		/*
+		 * Stage 1 tables for the window the firmware asks for.  The kit
+		 * builds LPAE tables with 4K leaves and validates every input, so
+		 * a non-Success answer here means our addresses or sizes are wrong
+		 * -- worth knowing before anything is programmed into the SMMU.
+		 */
+		{
+			extern kern_return_t kmem_alloc_contig(vm_map_t, vm_offset_t *,
+			    vm_size_t, vm_offset_t, ppnum_t, ppnum_t, kma_flags_t,
+			    vm_tag_t);
+			vm_offset_t tbl = 0;
+			kern_return_t tkr = kmem_alloc_contig(kernel_map, &tbl, 0x3000,
+			    0xfff, 0, 0, 0, VM_KERN_MEMORY_IOKIT);
+
+			if (tkr != KERN_SUCCESS || tbl == 0) {
+				kprintf("NABU SMMU TBL: kmem_alloc_contig failed %d\n", (int)tkr);
+				return;
+			}
+			bzero((void *)tbl, 0x3000);
+
+			ArmSmmu4KConfig cfg;
+			ArmSmmu4KRange range;
+			ArmSmmu4KResult res;
+			uint64_t gmu_pa = (uint64_t)ml_vtophys(va);
+			uint64_t tbl_pa = (uint64_t)ml_vtophys(tbl);
+
+			bzero(&cfg, sizeof(cfg));
+			bzero(&range, sizeof(range));
+			bzero(&res, sizeof(res));
+			cfg.input_bits = 32;
+			cfg.output_bits = 40;	/* the window lives above 4 GB */
+			cfg.table_physical = tbl_pa;
+			cfg.leaf_budget = 128;
+
+			range.iova = 0;
+			range.physical = gmu_pa;
+			range.bytes = 0x80000;
+			range.permissions = ArmSmmu4KRead | ArmSmmu4KWrite;
+			range.writeback = 0;
+			range.shareability = 3;
+
+			ArmSmmu4KStatus st = ArmSmmu4KBuild(&cfg, &range, 1,
+			    (uint64_t *)tbl, 3, &res);
+
+			kprintf("NABU SMMU TBL: gmu_pa %#llx tbl_pa %#llx status %d\n",
+			    (unsigned long long)gmu_pa, (unsigned long long)tbl_pa, (int)st);
+			kprintf("NABU SMMU TBL: start_level %u table_pages %u leaf_pages %u root %#llx\n",
+			    (unsigned)res.start_level, (unsigned)res.table_pages,
+			    (unsigned)res.leaf_pages, (unsigned long long)res.root_physical);
+
+			/*
+			 * Power the GPU's CX domain before touching the SMMU: reads work
+			 * with the domain off, but writes are dropped, which is exactly
+			 * what the empty context readback looked like.
+			 */
+			{
+				extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+				extern int nabu_gpu_steps(unsigned int steps);
+				int pst = nabu_gpu_steps(0x1u | 0x4u);   /* clocks + CX rail */
+
+				kprintf("NABU GPU PWR: steps(clocks|cx) = %d\n", pst);
+
+				vm_offset_t gd = ml_io_map(0x02c91000, 0x1000);
+
+				if (gd != 0) {
+					kprintf("NABU GPU PWR: cx gdscr %#x (read only)\n",
+					    *(volatile uint32_t *)(gd + 0x6c));
+				} else {
+					kprintf("NABU GPU PWR: gdsc map failed\n");
+				}
+			}
+
+			/*
+			 * GMU liveness: the always-on counter must tick, and the
+			 * processor own data memory must accept writes. Both are
+			 * plain registers, so no SMMU is involved.
+			 */
+			{
+				extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+				vm_offset_t gv;
+				volatile uint32_t *g;
+				uint32_t c1, c2, sr, fw, was, back;
+				unsigned spin;
+
+				gv = ml_io_map(0x02c6a000, 0x34000);
+				if (gv == 0) {
+					kprintf("NABU GMU TCM: map failed\n");
+				} else {
+					g = (volatile uint32_t *)gv;
+					sr = g[0x5000];
+					fw = g[0x501c];
+					c1 = g[0x5088];
+					for (spin = 0; spin < 200000; spin++) {
+						__asm__ volatile("" ::: "memory");
+					}
+					c2 = g[0x5088];
+					was = g[0x1c00];
+					g[0x1c00] = 0x600d0001u;
+					__asm__ volatile("dsb sy" ::: "memory");
+					back = g[0x1c00];
+					g[0x1c00] = was;
+					__asm__ volatile("dsb sy" ::: "memory");
+					kprintf("NABU GMU TCM: sysreset %#x fw_init %#x aon %#x -> %#x\n",
+					    sr, fw, c1, c2);
+					kprintf("NABU GMU TCM: dtcm %#x + 0x600d0001 -> %#x\n",
+					    was, back);
+				}
+			}
+
+			/* Hand the tables to context 0 and route the GMU streams to it. */
+			{
+				extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+				vm_offset_t sva = ml_io_map(0x02ca0000, 0x20000);
+
+				if (sva == 0) {
+					kprintf("NABU SMMU REG: map failed\n");
+					return;
+				}
+
+				ArmSmmu4KMmio mmio;
+				ArmSmmu4KIo io;
+				bzero(&mmio, sizeof(mmio));
+				bzero(&io, sizeof(io));
+				mmio.mapping = (volatile unsigned char *)sva;
+				mmio.bytes = 0x20000;
+
+				ArmSmmu4KStatus bst = ArmSmmu4KBindMmio(&mmio, &io);
+				uint32_t id0 = *(volatile uint32_t *)(sva + 0x20);
+				uint32_t id2 = *(volatile uint32_t *)(sva + 0x28);
+				uint32_t scr0 = *(volatile uint32_t *)(sva + 0x00);
+
+				uint32_t id1 = *(volatile uint32_t *)(sva + 0x24);
+
+				kprintf("NABU SMMU REG: bind %d id0 %#x id1 %#x id2 %#x scr0 %#x\n",
+				    (int)bst, id0, id1, id2, scr0);
+
+				/* prove the adapter itself works before trusting any status */
+				{
+					uint32_t v32 = 0;
+					uint64_t v64 = 0;
+					int r1 = io.read32(io.cookie, 0x20, &v32);
+					int r2 = io.read64(io.cookie, 0x20, &v64);
+					int r3 = io.write32(io.cookie, 0x78, 0);
+					int r4 = io.barrier(io.cookie);
+					kprintf("NABU SMMU IO: r32 %d v %#x | r64 %d v %#llx | w32 %d | bar %d\n",
+					    r1, v32, r2, (unsigned long long)v64, r3, r4);
+				}
+
+				ArmSmmu4KContextConfig cc;
+				ArmSmmu4KProgramResult pr;
+				bzero(&cc, sizeof(cc));
+				bzero(&pr, sizeof(pr));
+				cc.lower = &cfg;
+				cc.lower_tables = &res;
+				cc.id0 = id0;
+				cc.id2 = id2;
+				cc.asid = 1;
+				cc.coherent_walk = 0;
+				cc.stall_on_fault = 0;
+				cc.continue_after_fault = 0;
+
+				ArmSmmu4KStatus pst = ArmSmmu4KProgramDisabledContext(&io, 1, &cc,
+				    2000, &pr);
+				kprintf("NABU SMMU REG: context0 status %d offset %#x\n",
+				    (int)pst, (unsigned)pr.context_offset);
+				if (pst != ArmSmmu4KSuccess && pr.context_offset != 0 &&
+				    pr.context_offset + 0x40 <= 0x20000u) {
+					volatile uint32_t *cb =
+					    (volatile uint32_t *)(sva + pr.context_offset);
+					kprintf("NABU SMMU REG: cb sctlr %#x tcr %#x ttbr0 %#x %#x mair0 %#x\n",
+					    cb[0x00 / 4], cb[0x30 / 4], cb[0x20 / 4], cb[0x24 / 4],
+					    cb[0x38 / 4]);
+				}
+
+				if (pst == ArmSmmu4KSuccess) {
+					/*
+					 * The kit deliberately leaves SCTLR.M to the caller,
+					 * so enable the context here before routing streams
+					 * into it.
+					 */
+					volatile uint32_t *cbr =
+					    (volatile uint32_t *)(sva + pr.context_offset);
+					uint32_t sc = cbr[0];
+					uint32_t fsr = cbr[0x58 / 4];
+
+					kprintf("NABU SMMU REG: sctlr %#x fsr %#x\n", sc, fsr);
+					{
+						for (unsigned slot = 0; slot < 8; slot++) {
+							kprintf("NABU SMMU MAP: slot %u smr %#x s2cr %#x\n",
+							    slot,
+							    *(volatile uint32_t *)(sva + 0x800 + 4 * slot),
+							    *(volatile uint32_t *)(sva + 0xc00 + 4 * slot));
+						}
+					}
+
+					if (fsr != 0) {
+						uint32_t far_before = cbr[0x60 / 4];
+
+						cbr[0x58 / 4] = 0xffffffffu;
+						__asm__ volatile("dsb sy" ::: "memory");
+						kprintf("NABU SMMU REG: fsr cleared -> %#x far %#x gfsr %#x gsynr0 %#x\n",
+						    cbr[0x58 / 4], far_before,
+						    *(volatile uint32_t *)(sva + 0x48),
+						    *(volatile uint32_t *)(sva + 0x40));
+					}
+				}
+
+				if (pst == ArmSmmu4KSuccess) {
+					/* isolate the observation step the attach fails in */
+					ArmSmmu4KProgramResult ob;
+					bzero(&ob, sizeof(ob));
+					ArmSmmu4KStatus ost = ArmSmmu4KObserveOwnedContext(&io, 1, &cc, &ob);
+					kprintf("NABU SMMU OBS: status %d phase %u fault %#x far %#x\n",
+					    (int)ost, (unsigned)ob.phase, ob.fault_status,
+					    *(volatile uint32_t *)(sva + pr.context_offset + 0x60));
+				}
+
+				if (pst == ArmSmmu4KSuccess) {
+					ArmSmmu4KStreamState ss;
+					ArmSmmu4KStreamResult sr;
+
+					/*
+					 * The kit only takes over slots that are in the exact
+					 * FAULT encoding (2 << 16); anything extra makes it
+					 * answer Busy. Park slots 4 and 5 there first.
+					 */
+					*(volatile uint32_t *)(sva + 0xc00 + 4 * 4) = 0x20000u;
+					*(volatile uint32_t *)(sva + 0xc00 + 4 * 5) = 0x20000u;
+					__asm__ volatile("dsb sy" ::: "memory");
+					kprintf("NABU SMMU REG: parked s2cr4 %#x s2cr5 %#x\n",
+					    *(volatile uint32_t *)(sva + 0xc00 + 4 * 4),
+					    *(volatile uint32_t *)(sva + 0xc00 + 4 * 5));
+
+					ArmSmmu4KStream want[2];
+					bzero(&ss, sizeof(ss));
+					bzero(&sr, sizeof(sr));
+					bzero(want, sizeof(want));
+					want[0].slot = 4;
+					want[0].sid = 4;
+					want[1].slot = 5;
+					want[1].sid = 5;
+
+					ArmSmmu4KStatus sst = ArmSmmu4KAttachStreams(&io, &ss, want, 2, 1,
+					    &cc, &sr);
+					kprintf("NABU SMMU REG: streams status %d phase %u verified %u faulted %u gfault %#x\n",
+					    (int)sst, sr.phase, sr.streams_verified, sr.streams_faulted,
+					    sr.global_fault);
+				}
+
+				kprintf("NABU SMMU REG: SMR4 %#x S2CR4 %#x SMR5 %#x S2CR5 %#x\n",
+				    *(volatile uint32_t *)(sva + 0x810),
+				    *(volatile uint32_t *)(sva + 0xc10),
+				    *(volatile uint32_t *)(sva + 0x814),
+				    *(volatile uint32_t *)(sva + 0xc14));
+			}
+		}
+	}
+}
+#endif
+
+#if defined(NABU)
+/*
+ * The SCM IO-write call hangs with the layout Linux uses, and a hung SMC keeps
+ * the calling CPU for good. Run the attempts on their own thread so a hang
+ * costs one thread instead of the whole boot, and print before each attempt so
+ * the next boot replay names the layout that hung.
+ */
+static volatile unsigned nabu_scm_io_phase;
+static volatile uint64_t nabu_scm_io_rc[4];
+static volatile uint32_t nabu_m1_dtcm_before;
+static volatile uint32_t nabu_m1_dtcm_after;
+static volatile uint32_t nabu_m1_fw_result;
+static volatile uint32_t nabu_m1_done;
+
+/*
+ * M1: point the GMU's streams at our page tables, then walk the GMU through the
+ * register sequence that releases its processor and see whether its firmware
+ * reports itself started (fw_init_result & 0x1ff == 0x100).
+ *
+ * Register offsets are word-indexed in the vendor's a6xx_gmu.xml, so each is
+ * multiplied by four. Everything runs on its own thread: a stuck register must
+ * not keep the machine from booting.
+ */
+#define NABU_GMU_BASE		0x02c6a000ull
+#define NABU_SMMU_BASE		0x02ca0000ull
+#define NABU_GMU_W(n)		(4u * (n))
+
+static void
+nabu_gmu_write(volatile uint32_t *gmu, uint32_t off, uint32_t val)
+{
+	gmu[off / 4] = val;
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+static void
+nabu_gmu_start_thread(void *arg, wait_result_t wr)
+{
+	extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+	vm_offset_t gv;
+	vm_offset_t sv;
+	volatile uint32_t *gmu;
+	volatile uint32_t *smmu;
+	uint32_t result;
+	unsigned i;
+
+	(void)arg;
+	(void)wr;
+
+	gv = ml_io_map(NABU_GMU_BASE, 0x34000);
+	sv = ml_io_map(NABU_SMMU_BASE, 0x10000);
+	if (gv == 0 || sv == 0) {
+		kprintf("NABU M1: map failed gmu %p smmu %p\n", (void *)gv, (void *)sv);
+		return;
+	}
+	gmu = (volatile uint32_t *)gv;
+	smmu = (volatile uint32_t *)sv;
+
+	/*
+	 * The GPU block is power collapsed by the always-on sequencer whenever no
+	 * vote holds it up, so everything below has to happen in one tight
+	 * sequence: power it, rebuild the context it lost, then start the GMU.
+	 */
+	{
+		extern int nabu_gpu_steps(unsigned int steps);
+		extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+		vm_offset_t gd = ml_io_map(0x02c91000, 0x1000);
+		int pst;
+
+		kprintf("NABU M1: gdscr before %#x\n",
+		    (gd != 0) ? *(volatile uint32_t *)(gd + 0x6c) : 0xdeadbeefu);
+		pst = nabu_gpu_steps(0x1u | 0x4u);
+		kprintf("NABU M1: power steps %d, gdscr now %#x\n", pst,
+		    (gd != 0) ? *(volatile uint32_t *)(gd + 0x6c) : 0xdeadbeefu);
+	}
+
+	/*
+	 * The GMU's processor needs its own clock branch (gpu_cc_cx_gmu_clk at
+	 * GPUCC + 0x1098).  If it is off, nothing written into its code memory
+	 * will ever execute, which is exactly what the test program showed.
+	 */
+	{
+		extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+		vm_offset_t cc = ml_io_map(0x02c90000, 0x9000);
+		uint32_t cbcr;
+
+		if (cc != 0) {
+			cbcr = *(volatile uint32_t *)(cc + 0x1098);
+			kprintf("NABU M1: gmu clk cbcr %#x\n", cbcr);
+			if ((cbcr & 1u) == 0) {
+				*(volatile uint32_t *)(cc + 0x1098) = cbcr | 1u;
+				__asm__ volatile("dsb sy" ::: "memory");
+				kprintf("NABU M1: gmu clk enabled -> %#x\n",
+				    *(volatile uint32_t *)(cc + 0x1098));
+			}
+		}
+		kprintf("NABU M1: pwr_clk %#x (bit6 no power, bit7 no clock)\n",
+		    gmu[NABU_GMU_W(0x50d0) / 4]);
+	}
+
+	/* is the GPU still powered, and did context 1 take a fault? */
+	{
+		extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+		vm_offset_t gd = ml_io_map(0x02c91000, 0x1000);
+
+		kprintf("NABU M1: gdscr %#x cb1 sctlr %#x fsr %#x ttbr0 %#x\n",
+		    (gd != 0) ? *(volatile uint32_t *)(gd + 0x6c) : 0xdeadbeefu,
+		    smmu[0x9000 / 4], smmu[0x9058 / 4], smmu[0x9020 / 4]);
+	}
+
+	/* 1. route the GMU's two streams through context 1 */
+	smmu[(0x800 + 4 * 4) / 4] = 0x80000004u;
+	smmu[(0x800 + 4 * 5) / 4] = 0x80000005u;
+	__asm__ volatile("dsb sy" ::: "memory");
+	smmu[(0xc00 + 4 * 4) / 4] = 1u;
+	smmu[(0xc00 + 4 * 5) / 4] = 1u;
+	__asm__ volatile("dsb sy" ::: "memory");
+	kprintf("NABU M1: smr4 %#x s2cr4 %#x smr5 %#x s2cr5 %#x\n",
+	    smmu[(0x800 + 4 * 4) / 4], smmu[(0xc00 + 4 * 4) / 4],
+	    smmu[(0x800 + 4 * 5) / 4], smmu[(0xc00 + 4 * 5) / 4]);
+
+	/*
+	 * 2. hold the processor in reset while we configure it.  It reads as 0
+	 * here even though the firmware left it at 1, so assert it rather than
+	 * trusting what we find.
+	 */
+	kprintf("NABU M1: sysreset was %#x, asserting reset\n",
+	    gmu[NABU_GMU_W(0x5000) / 4]);
+	nabu_gmu_write(gmu, NABU_GMU_W(0x5000), 1);
+	kprintf("NABU M1: sysreset now %#x\n", gmu[NABU_GMU_W(0x5000) / 4]);
+
+	/*
+	 * 2b. wake the GMU's RPMh channel: until the always-on sequencer hands it
+	 * over, everything the firmware asks of RPMh is dropped and it stalls
+	 * without writing fw_init_result at all.
+	 */
+	{
+		uint32_t ack = 0;
+		unsigned t;
+
+		nabu_gmu_write(gmu, NABU_GMU_W(0x9307), 2);
+		for (t = 0; t < 2000; t++) {
+			ack = gmu[NABU_GMU_W(0x9308) / 4];
+			if (ack == 2) {
+				break;
+			}
+			__asm__ volatile("dsb sy" ::: "memory");
+			for (unsigned long spin = 0; spin < 2000; spin++) {
+				__asm__ volatile("" ::: "memory");
+			}
+		}
+		kprintf("NABU M1: rscc ack %#x after %u tries\n", ack, t);
+		nabu_gmu_write(gmu, NABU_GMU_W(0x9307), 0);
+	}
+
+	/* 3. the register sequence the vendor's driver performs before releasing it */
+	nabu_gmu_write(gmu, NABU_GMU_W(0x50f1), 1);
+	nabu_gmu_write(gmu, NABU_GMU_W(0x50f0), 1);
+	nabu_gmu_write(gmu, NABU_GMU_W(0x51cc), 1);
+	nabu_gmu_write(gmu, NABU_GMU_W(0x501c), 0);
+	nabu_gmu_write(gmu, NABU_GMU_W(0x5001), 2);
+	nabu_gmu_write(gmu, NABU_GMU_W(0x5185), 0x60000u);	/* HFI queue table */
+	nabu_gmu_write(gmu, NABU_GMU_W(0x5184), 1);
+	nabu_gmu_write(gmu, NABU_GMU_W(0x9311),
+	    (1u << 31) | (0xau << 18) | 0xa0u);
+	nabu_gmu_write(gmu, NABU_GMU_W(0x502d), 0x4052u);
+	nabu_gmu_write(gmu, NABU_GMU_W(0x5101), 0);
+	nabu_gmu_write(gmu, NABU_GMU_W(0x5182), 0x06030500u);	/* chip id */
+	nabu_gmu_write(gmu, NABU_GMU_W(0x5100), 0x62000u | 3u);	/* log window */
+	nabu_gmu_write(gmu, NABU_GMU_W(0x4c0f), 1);
+	nabu_gmu_write(gmu, NABU_GMU_W(0x4c00), 1);
+	nabu_gmu_write(gmu, NABU_GMU_W(0x4c01), 1);
+	nabu_gmu_write(gmu, NABU_GMU_W(0x50c0), 0x09c40400u);
+	nabu_gmu_write(gmu, NABU_GMU_W(0x50e8), 0xf11u);
+	nabu_gmu_write(gmu, NABU_GMU_W(0x5191), 0xffffffffu);
+	kprintf("NABU M1: configured, cfg %#x bootcfg %#x sysreset %#x\n",
+	    gmu[NABU_GMU_W(0x502d) / 4], gmu[NABU_GMU_W(0x5001) / 4],
+	    gmu[NABU_GMU_W(0x5000) / 4]);
+
+	/*
+	 * 4. let the firmware run just long enough to record where it trips, then
+	 * put it back in reset.  A stage-2 translation fault leaves the offending
+	 * address in FAR, which tells us what to map instead of guessing.
+	 */
+	{
+		uint32_t v0 = gmu[NABU_GMU_W(0x1c00 + 0xff8) / 4];
+		uint32_t far_reg;
+		uint32_t fsr_reg;
+		unsigned spin;
+
+		kprintf("NABU M1: dtcm version word %#x\n", v0);
+		nabu_gmu_write(gmu, NABU_GMU_W(0x5101), 0);
+		nabu_gmu_write(gmu, NABU_GMU_W(0x5000), 0);
+		kprintf("NABU M1: released for a moment\n");
+		for (spin = 0; spin < 200000; spin++) {
+			__asm__ volatile("dsb sy" ::: "memory");
+		}
+		far_reg = smmu[0x9060 / 4];
+		fsr_reg = smmu[0x9058 / 4];
+		nabu_gmu_write(gmu, NABU_GMU_W(0x5000), 1);
+		kprintf("NABU M1: cb1 fault fsr %#x far %#x (id %#x)\n",
+		    fsr_reg, far_reg, smmu[0x9000 / 4]);
+		kprintf("NABU M1: put back in reset, sysreset %#x\n",
+		    gmu[NABU_GMU_W(0x5000) / 4]);
+	}
+
+	result = 0;
+	i = 0;
+/* 5. wait for the firmware to say it is up */
+	result = gmu[NABU_GMU_W(0x501c) / 4];
+	for (i = 0; i < 10000; i++) {
+		if (result == 0xbabefaceu || (result & 0x1ffu) == 0x100u ||
+		    (result & 0xe00u) != 0) {
+			break;
+		}
+		__asm__ volatile("dsb sy" ::: "memory");
+		for (unsigned long spin = 0; spin < 200000; spin++) {
+			__asm__ volatile("" ::: "memory");
+		}
+		result = gmu[NABU_GMU_W(0x501c) / 4];
+	}
+	nabu_m1_fw_result = result;
+	nabu_m1_done = 1;
+	kprintf("NABU M1: fw_init_result %#x after %u polls\n", result, i);
+	kprintf("NABU M1: intr_info %#x hfi_ctrl %#x ao_host %#x\n",
+	    gmu[NABU_GMU_W(0x5192) / 4], gmu[NABU_GMU_W(0x5180) / 4],
+	    gmu[NABU_GMU_W(0x9305) / 4]);
+	if ((result & 0x1ffu) == 0x100u) {
+		kprintf("NABU M1: GMU FIRMWARE RUNS\n");
+	} else {
+		kprintf("NABU M1: GMU did not start\n");
+	}
+}
+#endif
