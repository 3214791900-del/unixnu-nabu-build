diff --git a/bsd/kern/bsd_init.c b/bsd/kern/bsd_init.c
index 25de5a3..56eb285 100644
--- a/bsd/kern/bsd_init.c
+++ b/bsd/kern/bsd_init.c
@@ -473,6 +473,26 @@ bsd_rooted_ramdisk(void)
  * of the tro_ucred field so that the uthread structure can be
  * used like any other.
  */
+#if defined(NABU)
+extern kern_return_t kernel_thread_start(thread_continue_t, void *, thread_t *);
+
+/*
+ * Heartbeat: the panel is the only output channel and userland logs do not
+ * reach it reliably, so one line every five seconds proves the kernel is still
+ * alive after the userspace has gone quiet.
+ */
+static void
+nabu_heartbeat(void *arg, wait_result_t result)
+{
+	(void)arg;
+	(void)result;
+	for (;;) {
+		kprintf("NABU ALIVE\n");
+		IOSleep(5000);
+	}
+}
+#endif
+
 void
 bsd_init(void)
 {
@@ -712,10 +732,16 @@ bsd_init(void)
 #if SOCKETS
 	/* Initialize per-CPU cache allocator */
 	mcache_init();
+#if defined(NABU)
+	kprintf("NABU BOOT: after mcache_init\n");
+#endif
 
 	/* Initialize mbuf's. */
 	bsd_init_kprintf("calling mbinit\n");
 	mbinit();
+#if defined(NABU)
+	kprintf("NABU BOOT: after mbinit\n");
+#endif
 	restricted_in_port_init();
 #endif /* SOCKETS */
 
@@ -726,26 +752,47 @@ bsd_init(void)
 #if CONFIG_AUDIT
 	bsd_init_kprintf("calling audit_init\n");
 	audit_init();
+#if defined(NABU)
+	kprintf("NABU BOOT: after audit_init\n");
+#endif
 #endif
 
 	/* Initialize kqueues */
 	bsd_init_kprintf("calling knote_init\n");
 	knote_init();
+#if defined(NABU)
+	kprintf("NABU BOOT: after knote_init\n");
+#endif
 
 	/* Initialize event handler */
 	bsd_init_kprintf("calling eventhandler_init\n");
 	eventhandler_init();
+#if defined(NABU)
+	kprintf("NABU BOOT: after eventhandler_init\n");
+#endif
 
 	/* Initialize for async IO */
 	bsd_init_kprintf("calling aio_init\n");
 	aio_init();
+#if defined(NABU)
+	kprintf("NABU BOOT: after aio_init\n");
+#endif
 
 	pthread_init();
+#if defined(NABU)
+	kprintf("NABU BOOT: after pthread_init\n");
+#endif
 	/* POSIX Shm and Sem */
 	bsd_init_kprintf("calling pshm_cache_init\n");
 	pshm_cache_init();
+#if defined(NABU)
+	kprintf("NABU BOOT: after pshm_cache_init\n");
+#endif
 	bsd_init_kprintf("calling psem_cache_init\n");
 	psem_cache_init();
+#if defined(NABU)
+	kprintf("NABU BOOT: after psem_cache_init\n");
+#endif
 
 	/*
 	 * Initialize protocols.  Block reception of incoming packets
@@ -754,14 +801,26 @@ bsd_init(void)
 #if NETWORKING
 	bsd_init_kprintf("calling nwk_wq_init\n");
 	nwk_wq_init();
+#if defined(NABU)
+	kprintf("NABU BOOT: after nwk_wq_init\n");
+#endif
 	bsd_init_kprintf("calling dlil_init\n");
 	dlil_init();
+#if defined(NABU)
+	kprintf("NABU BOOT: after dlil_init\n");
+#endif
 #endif /* NETWORKING */
 #if SOCKETS
 	bsd_init_kprintf("calling socketinit\n");
 	socketinit();
+#if defined(NABU)
+	kprintf("NABU BOOT: after socketinit\n");
+#endif
 	bsd_init_kprintf("calling domaininit\n");
 	domaininit();
+#if defined(NABU)
+	kprintf("NABU BOOT: after domaininit\n");
+#endif
 	iptap_init();
 #if FLOW_DIVERT
 	flow_divert_init();
@@ -769,7 +828,13 @@ bsd_init(void)
 #endif /* SOCKETS */
 #if SKYWALK
 	bsd_init_kprintf("calling skywalk_init\n");
+#if defined(NABU)
+	/* skywalk_init()'s self-tests stop the boot at sk_copy64_24; the UI bring-up
+	 * does not need networking. */
+	kprintf("NABU BOOT: skywalk_init() skipped\n");
+#else
 	(void) skywalk_init();
+#endif
 #endif /* SKYWALK */
 #if NETWORKING
 #if NECP
@@ -792,16 +857,28 @@ bsd_init(void)
 	/* Initialize kernel memory status notifications */
 	bsd_init_kprintf("calling memorystatus_init\n");
 	memorystatus_init();
+#if defined(NABU)
+	kprintf("NABU BOOT: after memorystatus_init\n");
+#endif
 #endif /* CONFIG_MEMORYSTATUS */
 
 	bsd_init_kprintf("calling sysctl_mib_init\n");
 	sysctl_mib_init();
+#if defined(NABU)
+	kprintf("NABU BOOT: after sysctl_mib_init\n");
+#endif
 
 	bsd_init_kprintf("calling bsd_autoconf\n");
 	bsd_autoconf();
+#if defined(NABU)
+	kprintf("NABU BOOT: after bsd_autoconf\n");
+#endif
 
 #if CONFIG_DTRACE
 	dtrace_postinit();
+#if defined(NABU)
+	kprintf("NABU BOOT: after dtrace_postinit\n");
+#endif
 #endif
 
 	/*
@@ -812,11 +889,17 @@ bsd_init(void)
 #include <loop.h>
 #if NLOOP > 0
 	bsd_init_kprintf("calling loopattach\n");
-	loopattach();                   /* XXX */
+	loopattach();
+#if defined(NABU)
+	kprintf("NABU BOOT: after loopattach\n");
+#endif                   /* XXX */
 #endif
 #if NGIF
 	/* Initialize gif interface (after lo0) */
 	gif_init();
+#if defined(NABU)
+	kprintf("NABU BOOT: after gif_init\n");
+#endif
 #endif
 
 #if PFLOG
@@ -828,6 +911,9 @@ bsd_init(void)
 	/* Register the built-in dlil ethernet interface family */
 	bsd_init_kprintf("calling ether_family_init\n");
 	ether_family_init();
+#if defined(NABU)
+	kprintf("NABU BOOT: after ether_family_init\n");
+#endif
 #endif /* ETHER */
 
 #if NETWORKING
@@ -863,25 +949,47 @@ bsd_init(void)
 	 */
 	bsd_init_kprintf("calling net_init_run\n");
 	net_init_run();
+#if defined(NABU)
+	kprintf("NABU BOOT: after net_init_run\n");
+#endif
 #endif /* NETWORKING */
 
 	bsd_init_kprintf("calling inittodr\n");
 	inittodr(0);
+#if defined(NABU)
+	kprintf("NABU BOOT: after inittodr\n");
+#endif
 
 	/* Mount the root file system. */
 	while (TRUE) {
 		int err;
 
 		bsd_init_kprintf("calling setconf\n");
+#if defined(NABU)
+		kprintf("NABU BOOT: setconf() enter\n");
+#endif
 		setconf();
+#if defined(NABU)
+		kprintf("NABU BOOT: setconf() done, rootdevice=%s rootdev=%#x\n",
+		    rootdevice, (unsigned int)rootdev);
+#endif
 #if CONFIG_NETBOOT
 		netboot = (mountroot == netboot_mountroot);
 #endif
 
 		bsd_init_kprintf("vfs_mountroot\n");
+#if defined(NABU)
+		kprintf("NABU BOOT: vfs_mountroot() enter\n");
+#endif
 		if (0 == (err = vfs_mountroot())) {
+#if defined(NABU)
+			kprintf("NABU BOOT: vfs_mountroot() = 0, root mounted\n");
+#endif
 			break;
 		}
+#if defined(NABU)
+		kprintf("NABU BOOT: vfs_mountroot() = %d, will retry\n", err);
+#endif
 		rootdevice[0] = '\0';
 #if CONFIG_NETBOOT
 		if (netboot) {
@@ -1098,6 +1206,17 @@ bsdinit_task(void)
 
 	bsd_init_kprintf("bsd_do_post - done");
 
+#if defined(NABU)
+	{
+		thread_t hb_thread = THREAD_NULL;
+		kern_return_t hb_kr = kernel_thread_start(nabu_heartbeat, NULL, &hb_thread);
+		if (hb_kr == KERN_SUCCESS) {
+			thread_deallocate(hb_thread);
+		} else {
+			kprintf("NABU ALIVE: thread start failed %d\n", hb_kr);
+		}
+	}
+#endif
 	load_init_program(p);
 	lock_trace = 1;
 }
diff --git a/iokit/bsddev/IOKitBSDInit.cpp b/iokit/bsddev/IOKitBSDInit.cpp
index 578a118..49359f5 100644
--- a/iokit/bsddev/IOKitBSDInit.cpp
+++ b/iokit/bsddev/IOKitBSDInit.cpp
@@ -683,10 +683,19 @@ IOFindBSDRoot( char * rootName, unsigned int rootNameSize,
 	assert(matching);
 	matching->setObject(gIOResourceMatchedKey, gIOBSDKey);
 
+#if defined(NABU)
+	IOLog("NABU ROOT: IOFindBSDRoot enter\n");
+#endif
 	if ((service = IOService::waitForMatchingService(matching, 30ULL * kSecondScale))) {
 		OSSafeReleaseNULL(service);
+#if defined(NABU)
+		IOLog("NABU ROOT: IOBSD resource matched\n");
+#endif
 	} else {
 		IOLog("!BSD\n");
+#if defined(NABU)
+		IOLog("NABU ROOT: IOBSD resource NOT matched (30 s timeout)\n");
+#endif
 	}
 	matching->release();
 	matching = NULL;
