+#if defined(NABU)
+#include "nabu_gmu_fw.h"
+
+/*
+ * Adreno 640 GMU microcode: decode, then plan the load the same way
+ * UniXNU's kits/AdrenoFirmware does -- a block is { address, length, type,
+ * value } followed by length bytes of payload, from offset 0 of the image.
+ * Nothing here touches the GPU yet; it only proves the image decodes and that
+ * every block lands where the firmware asks.
+ */
+static int
+nabu_b64val(char c)
+{
+	if (c >= 'A' && c <= 'Z') {
+		return c - 'A';
+	}
+	if (c >= 'a' && c <= 'z') {
+		return c - 'a' + 26;
+	}
+	if (c >= '0' && c <= '9') {
+		return c - '0' + 52;
+	}
+	if (c == '+') {
+		return 62;
+	}
+	if (c == '/') {
+		return 63;
+	}
+	return -1;
+}
+
+static void
+nabu_gmu_fw_probe(void)
+{
+	static uint8_t image[NABU_GMU_FW_BYTES];
+	const char *s = nabu_gmu_fw_b64;
+	size_t out = 0;
+	uint32_t acc = 0;
+	int bits = 0;
+
+	for (; *s != 0; s++) {
+		int v = nabu_b64val(*s);
+
+		if (v < 0) {
+			continue;       /* '=' padding and whitespace */
+		}
+		acc = (acc << 6) | (uint32_t)v;
+		bits += 6;
+		if (bits >= 8) {
+			bits -= 8;
+			if (out < sizeof(image)) {
+				image[out++] = (uint8_t)(acc >> bits);
+			}
+		}
+	}
+	if (out != NABU_GMU_FW_BYTES) {
+		kprintf("NABU GMU FW: decoded %u of %u bytes\n",
+		    (unsigned)out, (unsigned)NABU_GMU_FW_BYTES);
+		return;
+	}
+	kprintf("NABU GMU FW: decoded %u bytes\n", (unsigned)out);
+
+	size_t off = 0;
+	uint32_t blocks = 0, mapped = 0, highest = 0;
+
+	while (off + 16 <= sizeof(image)) {
+		const uint8_t *b = image + off;
+		uint32_t addr = (uint32_t)b[0] | (uint32_t)b[1] << 8 |
+		    (uint32_t)b[2] << 16 | (uint32_t)b[3] << 24;
+		uint32_t len = (uint32_t)b[4] | (uint32_t)b[5] << 8 |
+		    (uint32_t)b[6] << 16 | (uint32_t)b[7] << 24;
+
+		if (len > sizeof(image) - off - 16) {
+			kprintf("NABU GMU FW: block %u truncated\n", blocks);
+			break;
+		}
+		kprintf("NABU GMU FW: block %u addr %#x len %#x\n",
+		    blocks, addr, len);
+		if (addr + len > highest) {
+			highest = addr + len;
+		}
+		mapped += len;
+		blocks++;
+		off += 16 + len;
+	}
+	kprintf("NABU GMU FW: %u block(s), %u payload bytes, highest %#x, end %#x of %#x\n",
+	    blocks, mapped, highest, (uint32_t)off, (uint32_t)sizeof(image));
+
+	/*
+	 * Reserve one physically contiguous window wide enough for the highest
+	 * address the firmware asks for, then copy every block to its own offset.
+	 * This is the memory the GPU will later see through the SMMU; nothing is
+	 * handed to the hardware yet, so the only claim being made is that the
+	 * image fits and the copy round-trips.
+	 */
+	{
+		extern kern_return_t kmem_alloc_contig(vm_map_t, vm_offset_t *,
+		    vm_size_t, vm_offset_t, ppnum_t, ppnum_t, kma_flags_t,
+		    vm_tag_t);
+		extern vm_map_t kernel_map;
+		extern ppnum_t pmap_find_phys(pmap_t, vm_offset_t);
+		extern pmap_t kernel_pmap;
+		vm_size_t size = 0x80000;        /* 512 KB: 0x0 .. 0x7ffff */
+		vm_offset_t va = 0;
+		kern_return_t kr = kmem_alloc_contig(kernel_map, &va, size, 0, 0, 0, 0, 0);
+
+		if (kr != KERN_SUCCESS || va == 0) {
+			kprintf("NABU GMU MEM: kmem_alloc_contig failed %d\n", (int)kr);
+			return;
+		}
+
+		uint8_t *dst = (uint8_t *)va;
+		bzero(dst, size);
+		size_t copy = 0;
+		for (size_t at = 0; at + 16 <= sizeof(image);) {
+			const uint8_t *b = image + at;
+			uint32_t addr = (uint32_t)b[0] | (uint32_t)b[1] << 8 |
+			    (uint32_t)b[2] << 16 | (uint32_t)b[3] << 24;
+			uint32_t len = (uint32_t)b[4] | (uint32_t)b[5] << 8 |
+			    (uint32_t)b[6] << 16 | (uint32_t)b[7] << 24;
+
+			if (len == 0 || (size_t)addr + len > size) {
+				break;
+			}
+			bcopy(b + 16, dst + addr, len);
+			copy += len;
+			at += 16 + len;
+		}
+
+		/* the first and last few bytes must have landed where asked */
+		uint32_t sig0 = *(uint32_t *)(dst + 0x400);
+		uint32_t sig6 = *(uint32_t *)(dst + 0x57000);
+		ppnum_t pa = pmap_find_phys(kernel_pmap, va);
+
+		kprintf("NABU GMU MEM: va %p pa %#llx size %#llx copied %u\n",
+		    (void *)va, (unsigned long long)pa << 12,
+		    (unsigned long long)size, (unsigned)copy);
+		kprintf("NABU GMU MEM: word@0x400 %#x word@0x57000 %#x\n",
+		    sig0, sig6);
+	}
+}
+#endif
