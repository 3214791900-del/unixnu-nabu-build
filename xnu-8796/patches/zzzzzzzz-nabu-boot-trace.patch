diff --git a/iokit/Kernel/arm/NabuFramebuffer.cpp b/iokit/Kernel/arm/NabuFramebuffer.cpp
index 7afbd9f..dc57673 100644
--- a/iokit/Kernel/arm/NabuFramebuffer.cpp
+++ b/iokit/Kernel/arm/NabuFramebuffer.cpp
@@ -100,9 +100,24 @@ class IOMobileFramebuffer : public IOService {
 
 OSDefineMetaClassAndStructors(IOMobileFramebuffer, IOService);
 
+#if defined(NABU)
+/*
+ * iOS names its display driver class "AppleMobileFramebuffer" and matches it by
+ * that name (IOServiceMatching uses IOProviderClass, which walks the class
+ * chain).  The panel driver used to sit directly under IOMobileFramebuffer, so
+ * anything looking for the Apple name found nothing; keep the Apple name as an
+ * empty intermediate class so both names resolve to the same nub.
+ */
+class AppleMobileFramebuffer : public IOMobileFramebuffer {
+	OSDeclareDefaultStructors(AppleMobileFramebuffer);
+};
+
+OSDefineMetaClassAndStructors(AppleMobileFramebuffer, IOMobileFramebuffer);
+#endif
+
 class IOMobileFramebufferUserClient;
 
-class AppleCLCD : public IOMobileFramebuffer {
+class AppleCLCD : public AppleMobileFramebuffer {
 	OSDeclareDefaultStructors(AppleCLCD);
 
 	IOWorkLoop         *fWorkLoop;
@@ -147,7 +162,7 @@ public:
 	void present_fallback(void);
 };
 
-OSDefineMetaClassAndStructors(AppleCLCD, IOMobileFramebuffer);
+OSDefineMetaClassAndStructors(AppleCLCD, AppleMobileFramebuffer);
 
 class IOMobileFramebufferUserClient : public IOUserClient {
 	OSDeclareDefaultStructors(IOMobileFramebufferUserClient);
@@ -615,9 +630,13 @@ bool
 IOMobileFramebufferUserClient::initWithTask(task_t owningTask, void *securityID, UInt32 type)
 {
 	if (!IOUserClient::initWithTask(owningTask, securityID, type)) {
+		kprintf("NABU FB: user client initWithTask DENIED type %u\n", (unsigned)type);
 		return false;
 	}
 	fTask = owningTask;
+#if defined(NABU)
+	kprintf("NABU FB: user client initWithTask type %u\n", (unsigned)type);
+#endif
 	return true;
 }
 
@@ -626,9 +645,12 @@ IOMobileFramebufferUserClient::start(IOService *provider)
 {
 	fFB = OSDynamicCast(AppleCLCD, provider);
 	if (fFB == NULL || !IOUserClient::start(provider)) {
+		kprintf("NABU FB: user client start FAILED (fb %p)\n", fFB);
 		return false;
 	}
 	fFB->addClient(this);
+	kprintf("NABU FB: user client open OK, %u client(s)\n",
+	    fFB->fClients->getCount());
 	return true;
 }
 
@@ -690,6 +712,58 @@ IOMobileFramebufferUserClient::externalMethod(uint32_t selector, IOExternalMetho
 	uint64_t out[2] = { 0, 0 };
 	uint32_t outCount = 0;
 
+#if defined(NABU)
+	/*
+	 * Dump the raw arguments of the IOMobileFramebuffer selectors this driver
+	 * does not implement yet: their scalar inputs and the first bytes of any
+	 * structure input are the only way to work out what each one expects.
+	 * Known-good selectors stay silent, and each selector is printed a bounded
+	 * number of times so a polling caller cannot flood the console.
+	 */
+	{
+		static uint32_t s_seen[128];
+		static const uint32_t s_limit = 12;
+
+		switch (selector) {
+		case kNabuFBGetLayerDefaultSurface:
+		case kNabuFBSwapBegin:
+		case kNabuFBSwapEnd:
+		case kNabuFBSwapWait:
+		case kNabuFBGetID:
+		case kNabuFBGetDisplaySize:
+		case kNabuFBRequestPowerChange:
+		case kNabuFBIsMainDisplay:
+		case kNabuFBGetDotPitch:
+		case kNabuFBNotifications:
+			break;
+		default: {
+			uint32_t n = selector & 127;
+
+			if (s_seen[n]++ < s_limit) {
+				const uint8_t *sp = (const uint8_t *)args->structureInput;
+				uint32_t ssz = (uint32_t)args->structureInputSize;
+
+				kprintf("NABU FB: unknown sel %u argc=%u si=%u so=%u",
+				    selector, (unsigned)args->scalarInputCount,
+				    (unsigned)ssz,
+				    (unsigned)args->scalarOutputCount);
+				for (uint32_t i = 0; i < args->scalarInputCount && i < 4; i++) {
+					kprintf(" a%u=%llu", i,
+					    (unsigned long long)args->scalarInput[i]);
+				}
+				if (sp != NULL && ssz >= 8) {
+					kprintf(" data=%02x%02x%02x%02x %02x%02x%02x%02x",
+					    sp[0], sp[1], sp[2], sp[3],
+					    sp[4], sp[5], sp[6], sp[7]);
+				}
+				kprintf("\n");
+			}
+			break;
+		}
+		}
+	}
+#endif
+
 	switch (selector) {
 	case kNabuFBGetLayerDefaultSurface:
 		out[0] = nabu_surface_port_in_task(fFB->fSurface, fTask);
