diff --git a/bsd/net/if_gif.c b/bsd/net/if_gif.c
index 525f133..1418efb 100644
--- a/bsd/net/if_gif.c
+++ b/bsd/net/if_gif.c
@@ -65,6 +65,9 @@
 
 #include <sys/param.h>
 #include <sys/systm.h>
+#if defined(NABU)
+#include <kern/printf.h>	/* kprintf(): declared here, not in sys/systm.h */
+#endif
 #include <sys/kernel.h>
 #include <sys/malloc.h>
 #include <sys/mbuf.h>
@@ -250,30 +253,60 @@ gif_init(void)
 {
 	errno_t result;
 
+#if defined(NABU)
+	kprintf("NABU GIF: gif_init enter\n");
+#endif
 	/* Initialize the list of interfaces */
 	TAILQ_INIT(&gifs);
+#if defined(NABU)
+	kprintf("NABU GIF: TAILQ_INIT done\n");
+#endif
 
 	/* Register protocol registration functions */
+#if defined(NABU)
+	kprintf("NABU GIF: proto_register_plumber(PF_INET) enter\n");
+#endif
 	result = proto_register_plumber(PF_INET, APPLE_IF_FAM_GIF,
 	    gif_attach_proto_family, NULL);
+#if defined(NABU)
+	kprintf("NABU GIF: proto_register_plumber(PF_INET) = %d\n", result);
+#endif
 	if (result != 0) {
 		printf("proto_register_plumber failed for AF_INET error=%d\n",
 		    result);
 	}
 
+#if defined(NABU)
+	kprintf("NABU GIF: proto_register_plumber(PF_INET6) enter\n");
+#endif
 	result = proto_register_plumber(PF_INET6, APPLE_IF_FAM_GIF,
 	    gif_attach_proto_family, NULL);
+#if defined(NABU)
+	kprintf("NABU GIF: proto_register_plumber(PF_INET6) = %d\n", result);
+#endif
 	if (result != 0) {
 		printf("proto_register_plumber failed for AF_INET6 error=%d\n",
 		    result);
 	}
 
+#if defined(NABU)
+	kprintf("NABU GIF: if_clone_attach enter\n");
+#endif
 	result = if_clone_attach(&gif_cloner);
+#if defined(NABU)
+	kprintf("NABU GIF: if_clone_attach = %d\n", result);
+#endif
 	if (result != 0) {
 		panic("%s: if_clone_attach() failed, error %d", __func__, result);
 	}
 
+#if defined(NABU)
+	kprintf("NABU GIF: gif_clone_create enter\n");
+#endif
 	gif_clone_create(&gif_cloner, 0, NULL);
+#if defined(NABU)
+	kprintf("NABU GIF: gif_clone_create done\n");
+#endif
 }
 
