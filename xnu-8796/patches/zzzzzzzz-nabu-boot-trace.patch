@@ -473,6 +473,32 @@ bsd_rooted_ramdisk(void)
  * of the tro_ucred field so that the uthread structure can be
  * used like any other.
  */
+#if defined(NABU)
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+
+/*
+ * GPU IOMMU (qsmmu-v500 at 0x02ca0000) read-only probe.  Before any page table
+ * is built we need to know whether the block answers at all: the registers read
+ * all-ones when the GPU power domain is off.  Nothing is written here.
+ */
+static void
+nabu_smmu_probe(void)
+{
+	vm_offset_t va = ml_io_map(0x02ca0000, 0x1000);
+	volatile uint32_t *r;
+
+	if (va == 0) {
+		kprintf("NABU SMMU: ml_io_map failed\n");
+		return;
+	}
+	r = (volatile uint32_t *)va;
+	kprintf("NABU SMMU: SCR0=%08x IDR0=%08x IDR1=%08x IDR2=%08x IDR7=%08x SGFSR=%08x\n",
+	    r[0x000 / 4], r[0x020 / 4], r[0x024 / 4], r[0x028 / 4], r[0x03c / 4], r[0x048 / 4]);
+	kprintf("NABU SMMU: SMR0=%08x S2CR0=%08x SMR4=%08x S2CR4=%08x\n",
+	    r[0x800 / 4], r[0xc00 / 4], r[0x810 / 4], r[0xc10 / 4]);
+}
+#endif
+
