+static uint32_t *nabu_fb_base;
+
+void
+nabu_fb_text(int x, int y, const char *text, uint32_t colour, int scale)
+{
+	if (nabu_fb_base == NULL) {
+		nabu_fb_base = (uint32_t *)ml_io_map_unmappable(NABU_FB_BASE,
+		    (vm_size_t)NABU_FB_STRIDE * 2560, NABU_FB_WCOMB);
+		if (nabu_fb_base == NULL) {
+			return;
+		}
+	}
+	for (; *text != '\0'; text++, x += 8 * scale) {
+		unsigned char c = (unsigned char)*text;
+		if (c < 32 || c > 126) {
+			c = '?';
+		}
+		const unsigned char *glyph = nabu_font8x8[c - 32];
+		for (int row = 0; row < 8; row++) {
+			for (int col = 0; col < 8; col++) {
+				if ((glyph[row] & (1 << col)) == 0) {
+					continue;
+				}
+				for (int dy = 0; dy < scale; dy++) {
+					for (int dx = 0; dx < scale; dx++) {
+						int px = x + col * scale + dx;
+						int py = y + row * scale + dy;
+						if (px < 0 || px >= NABU_FB_WIDTH) {
+							continue;
+						}
+						uint32_t *dst = (uint32_t *)
+						    ((uintptr_t)nabu_fb_base +
+						    (size_t)py * NABU_FB_STRIDE +
+						    (size_t)px * 4);
+						*dst = colour;
+					}
+				}
+			}
+		}
+	}
+}
+
+/* red title plus a white detail line, for failures late in boot */
+void
+nabu_fb_panic(const char *title, const char *detail)
+{
+	nabu_fb_text(40, 40, title, 0xff0000ff, 4);
+	nabu_fb_text(40, 120, detail, 0xffffffff, 3);
+}
