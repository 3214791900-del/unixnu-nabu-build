+/*
+ * Marks painted straight into the panel buffer: once userland takes the screen
+ * the console log is unreadable, but these squares stay visible.  Index 0 means
+ * "our user client was entered", 1 "SwapBegin", 2 "swap() returned".
+ */
+extern "C" vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+
+static void
+nabu_fb_dot(unsigned int idx, uint32_t color)
+{
+	static volatile uint32_t *panel;
+	unsigned int x0 = 8 + idx * 24;
+	unsigned int y;
+	unsigned int x;
+
+	if (panel == 0) {
+		panel = (volatile uint32_t *)ml_io_map(0x9c000000, 0x10000);
+	}
+	if (panel == 0) {
+		return;
+	}
+	for (y = 0; y < 16; y++) {
+		for (x = 0; x < 16; x++) {
+			panel[y * 1600 + x0 + x] = color;
+		}
+	}
+}
+
+static inline void
+nabu_fb_put32(uint8_t *p, uint32_t off, uint32_t v)
+{
+	p[off + 0] = (uint8_t)(v);
+	p[off + 1] = (uint8_t)(v >> 8);
+	p[off + 2] = (uint8_t)(v >> 16);
+	p[off + 3] = (uint8_t)(v >> 24);
+}
