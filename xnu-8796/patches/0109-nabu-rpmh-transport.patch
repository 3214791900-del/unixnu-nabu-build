+/* PMIC5 LDO triple: voltage selector at +0, mode raw 7 at +8, enable at +4. */
+static int
+rh_send(uint32_t address, unsigned mv)
+{
+	static const uint32_t offsets[3] = {0, 8, 4};
+	const uint32_t values[3] = {mv, 7, 1};
+	int error = rh_send_cmds(address, offsets, values, 3);
+	if (!error) {
+		printf("NABU RPMH: L11C ACTIVE vote complete (rail voltage requires hardware verification)\n");
+	}
+	return error;
+}
+
+/*
+ * Exported for the GPU bring-up (nabu_rpmh_gpu.c): ARC level votes and the cnoc
+ * bus vote travel on this same RSC/TCS/cmd-db transport but with their own slave
+ * ids and payloads, which the LDO entry point above must never be asked to carry.
+ */
+int
+nabu_rpmh_lookup(const char *res, unsigned slave, uint32_t *address)
+{
+	/* slave 0 means "accept any slave id and report it" (see rh_lookup_slave). */
+	if (!res || !address || slave > 5) {
+		return EINVAL;
+	}
+	int error = rh_map();
+	if (error) {
+		return error;
+	}
+	return rh_lookup_slave(res, slave, address);
+}
+
+int
+nabu_rpmh_send_raw(const char *res, unsigned slave, const uint32_t *offsets,
+    const uint32_t *values, unsigned count)
+{
+	if (!res || !offsets || !values) {
+		return EINVAL;
+	}
+	if (__atomic_exchange_n(&rh_lock, 1, __ATOMIC_ACQUIRE)) {
+		return EBUSY;
+	}
+	int error = EIO;
+	uint32_t address = 0;
+	if (rh_poisoned) {
+		printf("NABU RPMH: previous uncertain transaction; refusing further access\n");
+		goto out;
+	}
+	error = rh_map();
+	if (!error) {
+		error = rh_lookup_slave(res, slave, &address);
+	}
+	if (!error) {
+		error = rh_send_cmds(address, offsets, values, count);
+	}
+out:
+	if (error) {
+		printf("NABU RPMH: %s slave-%u transaction failed errno=%d\n", res, slave, error);
+	}
+	__atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
+	return error;
+}
