diff --git a/bsd/dev/nabu_spmi.c b/bsd/dev/nabu_spmi.c
index 820ec8c..be2beff 100644
--- a/bsd/dev/nabu_spmi.c
+++ b/bsd/dev/nabu_spmi.c
@@ -9,6 +9,7 @@
 #include <sys/param.h>
 #include <sys/systm.h>
 #include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
 #include <IOKit/IOLocks.h>
 #include "nabu_spmi.h"
 
@@ -90,7 +91,9 @@ nabu_spmi_read(unsigned sid, unsigned addr, uint8_t *out)
 	unsigned peripheral = addr >> 8;
 	if (!sp_ready || !out || sid != 0 || addr > 0xffffu ||
 	    (peripheral != 0x10 && peripheral != 0x11 && peripheral != 0x12 &&
-	    peripheral != 0x13 && peripheral != 0x48)) {
+	    peripheral != 0x13 && peripheral != 0x48 &&
+	    /* PMIC regulator blocks (LDO/SMPS): read-only inspection. */
+	    (peripheral < 0x40 || peripheral > 0x5f))) {
 		return -1;
 	}
 	IOLockLock(sp_lock);
@@ -123,4 +126,164 @@ nabu_spmi_read(unsigned sid, unsigned addr, uint8_t *out)
 	IOLockUnlock(sp_lock);
 	return -1;
 }
+
+/*
+ * SPMI write path.  The observer command word puts the register in bits 4..11
+ * and - for EXT_WRITEL - the data in bits 12..19; bit 27 selects EXT_READL.
+ * Nothing here is called on a normal boot: nabu_spmi_write() refuses unless the
+ * boot arg nabuspmi_write=1 is present, because programming the wrong PMIC
+ * register can brown the board out.
+ */
+static int
+sp_write_enabled(void)
+{
+	static int enabled = -1;
+	if (enabled < 0) {
+		int v = 0;
+		enabled = PE_parse_boot_argn("nabuspmi_write", &v, sizeof(v)) && v;
+	}
+	return enabled;
+}
+
+int
+nabu_spmi_write(unsigned sid, unsigned addr, uint8_t value)
+{
+	unsigned peripheral = addr >> 8;
+
+	if (!sp_ready || sid != 0 || addr > 0xffffu) {
+		return -1;
+	}
+	if (!sp_write_enabled() || sp_count == 0 || sp_count > 512) {
+		return -1;
+	}
+	IOLockLock(sp_lock);
+	uint16_t apid = sp_find_apid((sid << 8) | peripheral);
+	if (apid == SP_NO_APID || sp_poisoned[apid]) {
+		IOLockUnlock(sp_lock);
+		return -1;
+	}
+	unsigned off = 0x80u * apid;
+	uint32_t cmd = ((addr & 0xffu) << 4) | ((uint32_t)value << 12);
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(sp_obs + off) = cmd;    /* EXT_WRITEL: bit 27 clear */
+	__asm__ volatile("dsb osh" ::: "memory");
+	for (unsigned i = 0; i < 1000; ++i) {
+		uint32_t status = sp_rd(sp_obs, off + 0x08u);
+		if (status & 1u) {
+			int rc = (status & 0x0eu) ? -1 : 0;
+			IOLockUnlock(sp_lock);
+			return rc;
+		}
+		delay(1);
+	}
+	sp_poisoned[apid] = true;
+	printf("NABU BATTERY: SPMI write timeout addr=%#x APID=%u disabled\n", addr, apid);
+	IOLockUnlock(sp_lock);
+	return -1;
+}
+
+/*
+ * Write self-test: read a register, write the same value back, read again.  A
+ * byte-identical result means the write command encoding is right, and because
+ * the value written equals what was there nothing actually changes.
+ */
+int
+nabu_spmi_write_selftest(void)
+{
+	/* PMIC peripheral revision registers: read-only-ish, stable, harmless. */
+	static const uint16_t probe[] = { 0x1004, 0x1104, 0x1204, 0x1304, 0x4804 };
+	uint8_t first, after;
+	int tested = 0;
+
+	if (!sp_ready || !sp_write_enabled()) {
+		return -1;
+	}
+	for (unsigned i = 0; i < sizeof(probe) / sizeof(probe[0]); i++) {
+		if (nabu_spmi_read(0, probe[i], &first) != 0) {
+			continue;
+		}
+		if (nabu_spmi_write(0, probe[i], first) != 0) {
+			printf("NABU BATTERY: SPMI write selftest addr=%#x: write refused\n",
+			    probe[i]);
+			continue;
+		}
+		if (nabu_spmi_read(0, probe[i], &after) != 0) {
+			continue;
+		}
+		printf("NABU BATTERY: SPMI write selftest addr=%#x value=%#x -> %#x %s\n",
+		    probe[i], first, after, first == after ? "OK" : "MISMATCH");
+		tested++;
+	}
+	return tested > 0 ? 0 : -1;
+}
+
+
+/*
+ * Read-only regulator inspection.  The mainline nabu device tree says the USB
+ * PHY needs vreg_l5a_0p8 / vreg_l12a_1p8 / vreg_l2a_3p1, but it does not give
+ * their SPMI addresses.  Rather than guess and write, dump a small window from
+ * every regulator-ish peripheral and read the answer off the hardware: a block
+ * that belongs to an LDO has a plausible EN_CTL at +0x40 and a voltage at
+ * +0x45, and non-existent blocks answer 0xff or fail outright.
+ */
+void
+nabu_spmi_regdump(void)
+{
+	static const unsigned peripherals[] = {
+		0x40, 0x41, 0x42, 0x43, 0x44, 0x45, 0x46, 0x47,
+		0x48, 0x49, 0x4a, 0x4b, 0x4c, 0x4d, 0x4e, 0x4f,
+	};
+	uint8_t v;
+
+	if (!sp_ready) {
+		return;
+	}
+	printf("NABU SPMI: regulator dump (read only)\n");
+	for (unsigned i = 0; i < sizeof(peripherals) / sizeof(peripherals[0]); i++) {
+		unsigned base = peripherals[i] << 8;
+		/* +0x40 enable, +0x45 voltage, +0x46 mode, +0x08 status window. */
+		int e = nabu_spmi_read(0, base | 0x40, &v);
+		if (e != 0) {
+			continue;
+		}
+		uint8_t en = v, volt = 0, mode = 0, st = 0;
+		(void)nabu_spmi_read(0, base | 0x45, &volt);
+		(void)nabu_spmi_read(0, base | 0x46, &mode);
+		(void)nabu_spmi_read(0, base | 0x08, &st);
+		printf("NABU SPMI: %#04x en=%#04x volt=%#04x mode=%#04x st=%#04x\n",
+		    base, en, volt, mode, st);
+	}
+	printf("NABU SPMI: regulator dump done\n");
+}
+
+
+/*
+ * Read-only APID table dump.  The arbiter maps every SPMI peripheral to an
+ * APID slot; reading the table says which peripherals exist and which slave
+ * (SID) they belong to.  Guessing regulator peripheral numbers is what made
+ * the previous dump come back empty.
+ */
+void
+nabu_spmi_apiddump(void)
+{
+	unsigned shown = 0;
+
+	if (!sp_ready) {
+		return;
+	}
+	printf("NABU SPMI: APID table (%u slots, read only)\n", sp_count);
+	for (unsigned i = 0; i < sp_count && shown < 48; i++) {
+		uint32_t map = sp_rd(sp_core, 0x900u + 4u * i);
+		if (!map) {
+			continue;
+		}
+		unsigned ppid = (map >> 8) & 0xfffu;   /* SID << 8 | peripheral */
+		uint32_t cfg = sp_rd(sp_cfg, 0x700u + 4u * i);
+		printf("NABU SPMI: apid=%u sid=%u periph=%#04x owner=%u map=%#x\n",
+		    i, (ppid >> 8) & 0xf, ppid & 0xff, cfg & 7u, map);
+		shown++;
+	}
+	printf("NABU SPMI: APID dump done (%u entries)\n", shown);
+}
+
 #endif /* ARM64_BOARD_CONFIG_NABU */
diff --git a/bsd/dev/nabu_spmi.h b/bsd/dev/nabu_spmi.h
index abaa1fd..24b9f7e 100644
--- a/bsd/dev/nabu_spmi.h
+++ b/bsd/dev/nabu_spmi.h
@@ -8,6 +8,14 @@ extern "C" {
 int nabu_spmi_init(void);
 /* Thread context only; 0 success, -1 failure; *out unchanged on failure. */
 int nabu_spmi_read(unsigned sid, unsigned addr, uint8_t *out);
+/* Thread context only; writes are refused unless nabuspmi_write=1. */
+int nabu_spmi_write(unsigned sid, unsigned addr, uint8_t value);
+/* Read -> write the same value back -> read again; 0 when they match. */
+int nabu_spmi_write_selftest(void);
+/* Read-only dump of the regulator blocks (nabuspmi_dump=1). */
+void nabu_spmi_regdump(void);
+/* Read-only dump of the SPMI APID table (nabuspmi_apid=1). */
+void nabu_spmi_apiddump(void);
 #ifdef __cplusplus
 }
 #endif
