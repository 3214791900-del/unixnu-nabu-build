--- a/iokit/Kernel/arm/NabuFramebuffer.cpp
+++ b/iokit/Kernel/arm/NabuFramebuffer.cpp
@@ -66,3 +66,15 @@
-#define NABU_FB_LOGICAL_W              1125
-#define NABU_FB_LOGICAL_H              2436
+/*
+ * The root filesystem is the iPad Pro 10.5 (iPadOS 16.6.1) image: its
+ * asset catalogs only carry the iPad screen sizes, and UIKit asserts on a
+ * missing per-screen bitmap
+ *   BoundingPathBitmap-<px>x<px>-<pt>x<pt>-<scale>x
+ * so the panel has to be presented as a real iPad screen.
+ *
+ * 1536x2048 (iPad mini, 768x1024 points @2x) is the smallest iPad size and
+ * therefore the most likely to fit whatever limit CoreAnimation puts on
+ * its software renderer ("image is too large for software renderer").
+ * /chosen/display-scale must be 2 in the ADT for this (mkadt.py).
+ */
+#define NABU_FB_LOGICAL_W              1536
+#define NABU_FB_LOGICAL_H              2048
 #define NABU_FB_FORMAT_BGRA            0x42475241
--- a/iokit/Kernel/arm/hid/NabuHID.cpp
+++ b/iokit/Kernel/arm/hid/NabuHID.cpp
@@ -424,6 +424,6 @@
 	PE_parse_boot_argn("nabufb_native", &native, sizeof(native));
-	fLogicalW = native ? 1080 : 1125;
-	fLogicalH = native ? 2400 : 2436;
-	fOffX = (fLogicalW - 1080) / 2;
-	fOffY = (fLogicalH - 2400) / 2;
+	fLogicalW = native ? 1600 : 1536;
+	fLogicalH = native ? 2560 : 2048;
+	fOffX = (fLogicalW - 1600) / 2;
+	fOffY = (fLogicalH - 2560) / 2;
 	/* The digitizer covers the main display (backboardd maps it 1:1). */
