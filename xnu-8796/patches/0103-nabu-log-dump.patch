diff --git a/bsd/dev/nabu_ufs.c b/bsd/dev/nabu_ufs.c
index e8c38a6..1884f72 100644
--- a/bsd/dev/nabu_ufs.c
+++ b/bsd/dev/nabu_ufs.c
@@ -807,6 +807,29 @@ nabu_log_start(void)
 	}
 }
 
+/*
+ * Only the lines worth reading when the panel is the only output: the
+ * display stack, the accelerator, IOKit matching and crashes.  Everything
+ * else in the ring is daemon spam (one exec line per spawn, one AKS line per
+ * key-store call) and would bury them.
+ */
+static int
+nabu_log_keep(const char *line)
+{
+	static const char *const want[] = {
+		"NABU FB:", "NABU SURF:", "NABU SCALER:", "NABU ACCEL:",
+		"IOK backboardd", "matching1", "CRASH ", "panic",
+	};
+	size_t i;
+
+	for (i = 0; i < sizeof(want) / sizeof(want[0]); i++) {
+		if (strnstr(line, want[i], strlen(line)) != NULL) {
+			return 1;
+		}
+	}
+	return 0;
+}
+
 /*
  * Dump the persisted ring (boot-arg nabulog_dump=1): the console log of the
  * PREVIOUS boot, printed on the panel this time, so a stuck boot can be read
@@ -841,7 +864,31 @@ nabu_log_dump(void)
 	if (total < len) {
 		len = (uint32_t)total;
 	}
-	start = (uint32_t)((total - len) % NABU_LOG_SIZE);
+	/*
+	 * The filter above keeps only a handful of lines, so scan the whole
+	 * ring: the panel shows the tail of the result, which is exactly the
+	 * most recent accelerator / matching events.
+	 */
+	len = NABU_LOG_SIZE;
+	if (total < len) {
+		len = (uint32_t)total;
+	}
+	/*
+	 * Which 16 KiB slice of the ring to print.  The ring is 4 MiB and the
+	 * only way to read it on this port is to photograph the panel, so let
+	 * each boot print a different slice: `nabudump_page=1` is the most
+	 * recent, 2 the slice before it, and so on.
+	 */
+	uint32_t page = 1;
+	PE_parse_boot_argn("nabudump_page", &page, sizeof(page));
+	if (page < 1) {
+		page = 1;
+	}
+	if ((uint64_t)page * len >= (uint64_t)total) {
+		start = 0;
+	} else {
+		start = (uint32_t)((total - (uint64_t)page * len) % NABU_LOG_SIZE);
+	}
 	if (start + len > NABU_LOG_SIZE) {
 		len = NABU_LOG_SIZE - start;
 	}
@@ -863,7 +910,9 @@ nabu_log_dump(void)
 
 		if (c == '\n') {
 			line[col] = '\0';
-			printf("%s\n", line);
+			if (nabu_log_keep(line)) {
+				printf("%s\n", line);
+			}
 			col = 0;
 			continue;
 		}
