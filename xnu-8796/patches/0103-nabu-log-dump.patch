 	struct nabu_log_header *h;
 
 	PE_parse_boot_argn("nabulog_dump", &on, sizeof(on));
@@ -841,7 +887,31 @@ nabu_log_dump(void)
 	if (total < len) {
 		len = (uint32_t)total;
 	}
-	start = (uint32_t)((total - len) % NABU_LOG_SIZE);
+	/*
+	 * The filter above keeps only a handful of lines, so scan the whole
+	 * ring: the panel shows the tail of the result, which is exactly the
+	 * most recent accelerator / matching events.
+	 */
+	len = NABU_LOG_SIZE;
+	if (total < len) {
+		len = (uint32_t)total;
+	}
+	/*
+	 * Which 16 KiB slice of the ring to print.  The ring is 4 MiB and the
+	 * only way to read it on this port is to photograph the panel, so let
+	 * each boot print a different slice: `nabudump_page=1` is the most
+	 * recent, 2 the slice before it, and so on.
+	 */
+	uint32_t page = 1;
+	PE_parse_boot_argn("nabudump_page", &page, sizeof(page));
+	if (page < 1) {
+		page = 1;
+	}
+	if ((uint64_t)page * len >= (uint64_t)total) {
+		start = 0;
+	} else {
+		start = (uint32_t)((total - (uint64_t)page * len) % NABU_LOG_SIZE);
+	}
 	if (start + len > NABU_LOG_SIZE) {
 		len = NABU_LOG_SIZE - start;
 	}
